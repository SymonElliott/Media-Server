<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}MediaServer{% endblock %}</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg:        #0d0d0d;
            --surface:   #1a1a1a;
            --surface2:  #242424;
            --border:    #333;
            --text:      #e0e0e0;
            --muted:     #888;
            --accent:    #5b9cf6;
            --accent-h:  #7ab3f8;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: system-ui, -apple-system, sans-serif;
            font-size: 15px;
            line-height: 1.5;
            min-height: 100vh;
        }

        /* ── Nav ── */
        nav {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 0 1.5rem;
            display: flex;
            align-items: center;
            height: 56px;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .brand {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--accent);
            text-decoration: none;
            letter-spacing: -0.3px;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .brand-ver {
            font-size: 0.68rem;
            color: var(--muted);
            font-weight: 500;
            letter-spacing: 0.2px;
            margin-left: 0.35rem;
            margin-right: 1rem;
            flex-shrink: 0;
            opacity: 0.75;
            align-self: center;
            padding-top: 1px;
        }
        .nav-links { display: flex; align-items: center; }
        nav a {
            color: var(--muted);
            text-decoration: none;
            padding: 0 0.75rem;
            height: 56px;
            display: flex;
            align-items: center;
            font-size: 0.9rem;
            border-bottom: 2px solid transparent;
            transition: color 0.15s, border-color 0.15s;
            white-space: nowrap;
        }
        nav a:hover  { color: var(--text); }
        nav a.active { color: var(--accent); border-bottom-color: var(--accent); }
        .nav-actions { margin-left: auto; display: flex; align-items: center; gap: 0.5rem; padding-left: 0.5rem; }
        .nav-profile-wrap { position: relative; margin-left: 0.25rem; }
        .nav-profile {
            width: 32px; height: 32px; border-radius: 50%;
            background: var(--accent); color: #fff;
            border: none; cursor: pointer; font-size: 0.85rem; font-weight: 600;
            display: flex; align-items: center; justify-content: center;
            transition: opacity 0.15s;
            font-family: inherit;
        }
        .nav-profile:hover { opacity: 0.85; }
        .nav-profile-menu {
            display: none; position: absolute; top: calc(100% + 10px); right: 0;
            background: var(--surface); border: 1px solid var(--border);
            border-radius: 8px; min-width: 160px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.4); z-index: 200;
            overflow: hidden;
        }
        .nav-profile-menu.open { display: block; }
        .nav-profile-name {
            padding: 0.6rem 1rem; font-size: 0.82rem; color: var(--muted);
            border-bottom: 1px solid var(--border); white-space: nowrap;
        }
        .nav-profile-signout {
            width: 100%; background: none; border: none; text-align: left;
            padding: 0.6rem 1rem; font-size: 0.85rem; color: var(--text);
            cursor: pointer; font-family: inherit; transition: background 0.1s;
        }
        .nav-profile-signout:hover { background: var(--surface2); }
        .btn-scan, .btn-upload {
            background: var(--surface2);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 0.35rem 0.85rem;
            border-radius: 6px;
            font-size: 0.85rem;
            cursor: pointer;
            white-space: nowrap;
            transition: background 0.15s, border-color 0.15s, color 0.15s;
        }
        .btn-scan:hover  { background: var(--accent); border-color: var(--accent); color: #fff; }
        .btn-upload:hover { background: var(--surface); border-color: var(--muted); }
        .btn-scan-reset {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--muted);
            width: 1.7rem;
            height: 1.7rem;
            border-radius: 6px;
            font-size: 1rem;
            cursor: pointer;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: background 0.15s, color 0.15s, border-color 0.15s;
        }
        .btn-scan-reset:hover { background: #ef4444; border-color: #ef4444; color: #fff; }
        .btn-scan-reset.hidden { display: none; }

        /* ── Nav toggle ── */
        .nav-toggle {
            display: flex;
            align-items: center;
            background: none;
            border: none;
            color: var(--muted);
            cursor: pointer;
            padding: 0.4rem;
            margin-right: 0.25rem;
            border-radius: 6px;
            transition: color 0.15s, background 0.15s;
        }
        .nav-toggle:hover { color: var(--text); background: var(--surface2); }
        /* nav is position:sticky (main nav block above) which already creates a positioning
           context for the .nav-links absolute dropdown — no extra declaration needed. */
        .nav-links {
            display: none;
            position: absolute;
            top: 56px;
            left: 0; right: 0;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            flex-direction: column;
            align-items: stretch;
            padding: 0.5rem 0;
            z-index: 99;
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
        }
        .nav-links.open { display: flex; }
        .nav-links a {
            height: auto;
            padding: 0.75rem 1.5rem;
            border-bottom: none;
            border-left: 2px solid transparent;
        }
        .nav-links a.active { border-left-color: var(--accent); border-bottom: none; }
        .nav-links-divider {
            height: 1px; background: var(--border); margin: 0.35rem 1rem;
        }


        /* ── Upload modal ── */
        .upload-modal-backdrop {
            position: fixed; inset: 0; background: rgba(0,0,0,0.65);
            z-index: 500; display: flex; align-items: center; justify-content: center;
        }
        .upload-modal {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: 10px; padding: 1.75rem; width: 100%; max-width: 500px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5); position: relative;
        }
        .upload-modal h2 { color: var(--text); font-size: 1.1rem; margin-bottom: 1.25rem; }
        .upload-field { margin-bottom: 1rem; }
        .upload-field label { display: block; font-size: 0.82rem; color: var(--muted); margin-bottom: 0.3rem; }
        .upload-field select,
        .upload-field input[type="file"] {
            width: 100%; background: var(--surface2); border: 1px solid var(--border);
            border-radius: 6px; color: var(--text); font-size: 0.9rem;
            padding: 0.4rem 0.6rem; box-sizing: border-box;
        }
        .upload-field input[type="file"] { padding: 0.3rem; cursor: pointer; }
        .upload-actions { display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 1.25rem; }
        .upload-results { margin-top: 1.25rem; border-top: 1px solid var(--border); padding-top: 1rem; }
        .upload-result-row {
            display: flex; align-items: flex-start; gap: 0.5rem;
            font-size: 0.83rem; margin-bottom: 0.6rem; line-height: 1.4;
        }
        .upload-result-icon { flex-shrink: 0; width: 1.1rem; text-align: center; }
        .upload-result-name { font-weight: 500; color: var(--text); }
        .upload-result-dest { color: var(--muted); font-size: 0.78rem; word-break: break-all; }
        .upload-result-err  { color: #e05; font-size: 0.78rem; }
        .upload-spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.7s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* ── Main layout ── */
        main { padding: 2rem; max-width: 1400px; margin: 0 auto; }

        /* ── Typography ── */
        h1 { font-size: 1.6rem; font-weight: 700; margin-bottom: 1.5rem; }
        h2 { font-size: 1.1rem; font-weight: 600; color: var(--muted); margin-bottom: 1rem; }

        /* ── Cards ── */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 1rem;
        }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1rem;
            text-decoration: none;
            color: var(--text);
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            transition: border-color 0.15s, background 0.15s;
            overflow: hidden;
        }
        .card:hover { border-color: var(--accent); background: var(--surface2); }
        .card .card-title { font-weight: 600; font-size: 0.95rem; word-break: break-word; }
        .card .card-meta  { font-size: 0.8rem; color: var(--muted); }
        .card .card-icon  { font-size: 2rem; margin-bottom: 0.25rem; }
        .card-poster { width: 100%; aspect-ratio: 2/3; object-fit: cover; border-radius: 4px; margin-bottom: 0.25rem; }
        .card-poster--square, .card-poster-empty--square { aspect-ratio: 1/1; }
        .card-poster-empty { width: 100%; aspect-ratio: 2/3; background: var(--surface2); border-radius: 4px; margin-bottom: 0.25rem; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; }
        .card.meta-pending { opacity: 0.7; }
        .btn-view-toggle {
            background: var(--surface2); border: 1px solid var(--border);
            color: var(--muted); padding: 0.4rem 0.65rem; border-radius: 6px;
            font-size: 0.95rem; cursor: pointer; line-height: 1;
            transition: border-color 0.15s, color 0.15s;
        }
        .btn-view-toggle:hover, .btn-view-toggle.active { border-color: var(--accent); color: var(--accent); }
        .browse-tabs { display: flex; gap: 0.25rem; }
        .browse-tab {
            padding: 0.3rem 0.85rem; border-radius: 20px; font-size: 0.82rem; font-weight: 600;
            text-decoration: none; color: var(--muted); background: var(--surface2);
            border: 1px solid transparent; transition: color 0.15s, border-color 0.15s;
        }
        .browse-tab:hover { color: var(--text); border-color: var(--border); }
        .browse-tab.active { color: var(--accent); border-color: var(--accent); background: rgba(91,156,246,0.1); }

        /* ── People ── */
        .people-role-tabs { display: flex; gap: 0.5rem; }
        .people-role-tabs a {
            padding: 0.3rem 0.9rem; border-radius: 20px; font-size: 0.85rem;
            text-decoration: none; color: var(--muted);
            border: 1px solid var(--border); transition: all 0.15s;
        }
        .people-role-tabs a:hover, .people-role-tabs a.active {
            color: var(--text); border-color: var(--accent); background: var(--surface2);
        }
        .people-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 1.25rem;
            margin-bottom: 2rem;
        }
        .person-card {
            display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
            text-decoration: none; color: var(--text); text-align: center;
            padding: 0.75rem; border-radius: 8px;
            transition: background 0.15s;
        }
        .person-card:hover { background: var(--surface2); }
        .person-avatar {
            width: 90px; height: 90px; border-radius: 50%; overflow: hidden;
            background: var(--surface2); border: 2px solid var(--border);
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        }
        .person-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .person-initials { font-size: 1.4rem; font-weight: 700; color: var(--muted); }
        .person-card-name { font-size: 0.85rem; font-weight: 600; word-break: break-word; }
        .person-card-role { font-size: 0.75rem; color: var(--muted); }
        .person-hero-avatar img { border-radius: 50% !important; }
        .people-pagination {
            display: flex; align-items: center; justify-content: center; gap: 1.5rem;
            margin: 2rem 0; color: var(--muted); font-size: 0.9rem;
        }
        .people-pagination a { color: var(--accent); text-decoration: none; }

        /* ── List view ── */
        .item-list { display: flex; flex-direction: column; gap: 0.5rem; }
        .item-row-wrap { display: flex; align-items: stretch; }
        .item-row {
            flex: 1;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 6px 0 0 6px;
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            text-decoration: none;
            color: var(--text);
            transition: border-color 0.15s;
        }
        /* When no sibling menu button, restore full border-radius */
        .item-row:only-child,
        .item-list > .item-row { border-radius: 6px; }
        .item-row:hover { border-color: var(--accent); }
        .item-row .item-icon { font-size: 1.3rem; flex-shrink: 0; }
        .item-row .item-name { flex: 1; font-weight: 500; }
        .item-row .item-meta { font-size: 0.8rem; color: var(--muted); white-space: nowrap; }
        /* Menu button adjacent to item-row inside a wrap */
        .item-row-wrap .item-menu-btn {
            background: var(--surface); border: 1px solid var(--border); border-left: none;
            border-radius: 0 6px 6px 0; padding: 0 0.75rem; font-size: 1rem;
            color: var(--muted); cursor: pointer; transition: color 0.15s, background 0.15s;
            font-family: inherit; letter-spacing: 1px;
        }
        .item-row-wrap .item-menu-btn:hover,
        .item-row-wrap .item-menu-btn.active { color: var(--text); background: var(--surface2); }

        /* ── Breadcrumb ── */
        .breadcrumb { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1.5rem; font-size: 0.9rem; color: var(--muted); }
        .breadcrumb a { color: var(--accent); text-decoration: none; }
        .breadcrumb a:hover { text-decoration: underline; }
        .breadcrumb .sep { color: var(--border); }

        /* ── Player ── */
        .player-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; margin-bottom: 1.5rem; }
        .player-wrap video,
        .player-wrap audio { width: 100%; display: block; }
        .player-wrap audio  { padding: 1rem; }

        /* ── Play placeholder ── */
        .player-placeholder {
            position: relative;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 1.5rem;
            cursor: pointer;
            background: var(--surface);
            border: 1px solid var(--border);
        }
        .placeholder-bg {
            display: block;
            width: 100%;
            max-height: 480px;
            object-fit: cover;
            filter: brightness(0.45);
        }
        .placeholder-bg--blank {
            height: 260px;
            background: var(--surface2);
        }
        .placeholder-bg--square {
            max-height: 280px;
            object-fit: contain;
            background: #000;
        }
        .play-btn {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            background: transparent;
            border: none;
            cursor: pointer;
            color: #fff;
        }
        .play-icon {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: rgba(255,255,255,0.15);
            border: 2px solid rgba(255,255,255,0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            padding-left: 4px; /* optical center for ▶ */
            backdrop-filter: blur(4px);
            transition: background 0.15s, transform 0.1s;
        }
        .player-placeholder:hover .play-icon {
            background: rgba(255,255,255,0.25);
            transform: scale(1.06);
        }
        .play-label {
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-shadow: 0 1px 4px rgba(0,0,0,0.6);
        }

        /* ── Meta table ── */
        .meta-table { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
        .meta-table table { width: 100%; border-collapse: collapse; }
        .meta-table td { padding: 0.6rem 1rem; border-bottom: 1px solid var(--border); }
        .meta-table td:first-child { color: var(--muted); font-size: 0.85rem; width: 140px; }
        .meta-table tr:last-child td { border-bottom: none; }

        /* ── Pagination ── */
        .pagination { display: flex; gap: 0.5rem; margin-top: 2rem; justify-content: center; }
        .pagination a, .pagination span {
            padding: 0.4rem 0.8rem;
            border-radius: 5px;
            border: 1px solid var(--border);
            text-decoration: none;
            color: var(--text);
            font-size: 0.85rem;
        }
        .pagination a:hover  { border-color: var(--accent); color: var(--accent); }
        .pagination .current { background: var(--accent); border-color: var(--accent); color: #fff; }

        /* ── Stat cards (home) ── */
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }
        .stat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1.5rem;
            text-decoration: none;
            color: var(--text);
            position: relative;
            overflow: hidden;
            transition: border-color 0.3s;
        }
        .stat-card:hover { border-color: var(--accent); }
        .stat-card .stat-icon  { font-size: 2.2rem; margin-bottom: 0.75rem; }
        .stat-card .stat-label { font-size: 0.85rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
        .stat-card .stat-count { font-size: 2rem; font-weight: 700; }
        .stat-card .stat-sub   { font-size: 0.8rem; color: var(--muted); margin-top: 0.2rem; }

        /* ── Item detail layout (entity_detail / directory) ── */
        .item-layout { display: flex; gap: 2rem; align-items: flex-start; }
        .item-poster { flex-shrink: 0; width: 220px; }
        .item-poster img { width: 100%; border-radius: 8px; border: 1px solid var(--border); display: block; }
        .item-body { flex: 1; min-width: 0; }
        .item-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
        .item-subtitle { font-size: 0.9rem; color: var(--muted); margin-top: 0.3rem; display: flex; flex-wrap: wrap; gap: 0.25rem; align-items: center; }
        .item-subtitle .sep { color: var(--border); }
        .item-description { color: var(--muted); line-height: 1.7; margin-bottom: 1.5rem; font-size: 0.95rem; }
        .item-section { margin-bottom: 1.5rem; }
        .item-section h2 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); margin-bottom: 0.5rem; }

        /* ── Cast chips ── */
        .cast-list { display: flex; flex-wrap: wrap; gap: 0.4rem; }
        .cast-chip { background: var(--surface2); border: 1px solid var(--border); border-radius: 20px; padding: 0.2rem 0.7rem; font-size: 0.82rem; color: var(--text); }

        /* ── Item hero banner (item detail page) ── */
        .item-hero {
            position: relative;
            margin: 0 -2rem 2.5rem;
            min-height: 440px;
            display: flex;
            align-items: flex-end;
            overflow: hidden;
            background: #060606;
        }
        .item-hero-bg {
            position: absolute;
            inset: 0;
            background-image: var(--hero-poster, none);
            background-size: cover;
            background-position: center 20%;
            filter: blur(10px) brightness(0.28);
            transform: scale(1.1);
        }
        .item-hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top,
                rgba(13,13,13,0.98) 0%,
                rgba(13,13,13,0.55) 50%,
                rgba(13,13,13,0.1) 100%);
        }
        .item-hero-content {
            position: relative;
            z-index: 1;
            padding: 2.5rem 2rem 2.5rem;
            width: 100%;
            display: flex;
            align-items: flex-end;
            gap: 2rem;
        }
        .item-hero-poster {
            flex-shrink: 0;
            width: 160px;
        }
        .item-hero-poster--square { width: 160px; }
        .item-hero-poster--square img { aspect-ratio: 1/1; object-fit: cover; }
        .item-hero-poster img {
            width: 100%;
            border-radius: 8px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.7);
            display: block;
        }
        .item-hero-info { flex: 1; min-width: 0; }
        .item-hero-eyebrow {
            font-size: 0.78rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.4px;
            color: rgba(255,255,255,0.45);
            margin-bottom: 0.5rem;
        }
        .item-hero h1 {
            font-size: clamp(1.8rem, 4vw, 3rem);
            font-weight: 800;
            color: #fff;
            line-height: 1.1;
            margin-bottom: 0.6rem;
            text-shadow: 0 2px 20px rgba(0,0,0,0.7);
        }
        .item-hero-sub {
            font-size: 0.9rem;
            color: rgba(255,255,255,0.55);
            margin-bottom: 1.75rem;
            letter-spacing: 0.2px;
        }
        .item-hero-actions {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }
        .btn-play-hero {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            background: #fff;
            color: #000;
            padding: 0.6rem 1.5rem;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.95rem;
            border: none;
            cursor: pointer;
            font-family: inherit;
            letter-spacing: 0.2px;
            transition: background 0.15s, transform 0.1s;
        }
        .btn-play-hero:hover { background: rgba(255,255,255,0.85); transform: scale(1.02); }

        /* ── Item detail body (below hero) ── */
        .item-detail-body { max-width: 900px; }
        .item-detail-body .item-description {
            color: var(--muted); line-height: 1.8; margin-bottom: 2rem; font-size: 0.95rem;
        }
        .item-detail-body .item-section { margin-bottom: 1.75rem; }
        .item-detail-body .item-section h2 {
            font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.8px;
            color: var(--muted); margin-bottom: 0.6rem;
        }
        .hero-audio { width: 100%; max-width: 480px; accent-color: var(--accent); }

        .chapter-list { display: flex; flex-direction: column; gap: 2px; }
        .chapter-row {
            display: flex; align-items: center; gap: 0.75rem;
            background: none; border: none; border-radius: 6px;
            padding: 0.45rem 0.6rem; cursor: pointer; text-align: left; width: 100%;
            color: var(--text); transition: background 0.12s;
        }
        .chapter-row:hover { background: var(--surface2); }
        .chapter-row.chapter-active { background: var(--surface2); color: var(--accent); }
        .chapter-time { font-variant-numeric: tabular-nums; font-size: 0.82rem; color: var(--muted); min-width: 3.5rem; flex-shrink: 0; }
        .chapter-row.chapter-active .chapter-time { color: var(--accent); }
        .chapter-title { font-size: 0.92rem; }

        @media (max-width: 640px) {
            .item-hero { margin: 0 -1rem 2rem; min-height: 0; }
            .item-hero-content { flex-direction: column; align-items: flex-start; padding: 2rem 1rem 1.75rem; gap: 1.25rem; }
            .item-hero-poster { width: 110px; }
            .item-hero h1 { font-size: 1.6rem; }
        }

        /* ── Buttons ── */
        .btn-refresh {
            background: var(--surface2); border: 1px solid var(--border);
            color: var(--muted); padding: 0.4rem 0.85rem; border-radius: 6px;
            font-size: 0.82rem; cursor: pointer; white-space: nowrap;
            transition: border-color 0.15s, color 0.15s;
        }
        .btn-refresh:hover { border-color: var(--accent); color: var(--accent); }
        .btn-play {
            display: inline-block; background: var(--accent); color: #fff;
            padding: 0.6rem 1.2rem; border-radius: 6px; text-decoration: none;
            font-weight: 500; font-size: 0.9rem;
        }

        /* ── Browse thumbnails ── */
        .item-thumb { width: 40px; height: 40px; object-fit: cover; border-radius: 4px; flex-shrink: 0; }
        .item-thumb--square { border-radius: 3px; }

        @media (max-width: 600px) {
            .item-layout { flex-direction: column; }
            .item-poster { width: 100%; max-width: 260px; }
        }

        /* ── Scan tile states ── */
        .stat-card.tile-active { border-color: var(--accent); }
        .stat-card.tile-done   { border-color: rgba(74,222,128,0.45); }

        .tile-progress {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            height: 3px;
        }
        .tile-progress-fill {
            height: 100%;
            width: 0%;
            transition: width 0.9s ease;
            border-radius: 0 2px 0 0;
        }
        .tile-active .tile-progress-fill {
            background: var(--accent);
        }
        .tile-done .tile-progress-fill {
            background: #4ade80;
            width: 100% !important;
            transition: none;
        }
        /* Shimmer for metadata phase — indeterminate when no per-type total available */
        @keyframes shimmer {
            0%   { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
        .tile-active.tile-meta .tile-progress-fill {
            width: 100% !important;
            background: linear-gradient(90deg, var(--accent) 0%, var(--accent-h) 50%, var(--accent) 100%);
            background-size: 200% 100%;
            animation: shimmer 1.4s linear infinite;
        }

        /* ── Scan progress bar ── */
        #scan-progress {
            position: fixed;
            top: 56px; left: 0; right: 0;
            height: 4px;
            z-index: 99;
            background: transparent;
            display: none;
            pointer-events: none;
        }
        #scan-progress-fill {
            height: 100%;
            width: 0%;
            background: var(--accent);
            transition: width 0.7s ease;
            border-radius: 0 2px 2px 0;
        }
        #scan-progress.indeterminate #scan-progress-fill {
            width: 100% !important;
            background: linear-gradient(90deg, var(--bg) 0%, var(--accent) 30%, var(--accent-h) 70%, var(--bg) 100%);
            background-size: 200% 100%;
            animation: shimmer 1.4s linear infinite;
            transition: none;
            border-radius: 0;
        }

        /* ── Scan item name label ── */
        #scan-item-label {
            position: fixed;
            top: 60px; left: 0; right: 0;
            font-size: 0.7rem;
            color: rgba(224, 224, 224, 0.55);
            padding: 3px 12px;
            display: none;
            pointer-events: none;
            z-index: 98;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            background: rgba(13, 13, 13, 0.82);
            letter-spacing: 0.15px;
        }

        /* ── Ellipsis menu button ── */
        .item-menu-btn {
            background: none; border: none; color: var(--muted); cursor: pointer;
            padding: 0.2rem 0.5rem; font-size: 1.1rem; border-radius: 4px;
            flex-shrink: 0; transition: color 0.15s;
            font-family: inherit; line-height: 1; letter-spacing: 1px;
        }
        .item-menu-btn:hover,
        .item-menu-btn.active { color: var(--text); background: var(--surface2); }

        /* ── Context menu dropdown ── */
        .item-dropdown {
            position: fixed; z-index: 300;
            background: var(--surface2); border: 1px solid var(--border);
            border-radius: 7px; min-width: 140px;
            box-shadow: 0 6px 24px rgba(0,0,0,0.5); overflow: hidden;
        }
        .item-dropdown button {
            display: block; width: 100%; background: none; border: none;
            padding: 0.55rem 1rem; text-align: left; cursor: pointer;
            color: var(--text); font-size: 0.88rem; font-family: inherit;
            transition: background 0.1s;
        }
        .item-dropdown button:hover    { background: var(--surface); }
        .item-dropdown .dd-danger      { color: #f87171; }
        .item-dropdown .dd-danger:hover { background: rgba(248,113,113,0.08); }

        /* ── Modal ── */
        .modal-overlay {
            position: fixed; inset: 0; background: rgba(0,0,0,0.72);
            z-index: 400; display: flex; align-items: center; justify-content: center; padding: 1rem;
        }
        .modal-panel {
            background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
            padding: 1.75rem; width: 100%; max-width: 580px; max-height: 92vh; overflow-y: auto;
        }
        .modal-head {
            display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;
        }
        .modal-head h2 { font-size: 1rem; font-weight: 600; }
        .modal-close {
            background: none; border: none; color: var(--muted); cursor: pointer;
            font-size: 1.1rem; padding: 0.2rem 0.4rem; border-radius: 4px;
        }
        .modal-close:hover { color: var(--text); }
        .form-group { margin-bottom: 1rem; }
        .form-group label {
            display: block; font-size: 0.75rem; color: var(--muted);
            text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.3rem;
        }
        .form-group input, .form-group textarea, .form-group select {
            width: 100%; background: var(--surface2); border: 1px solid var(--border);
            border-radius: 5px; color: var(--text); padding: 0.5rem 0.75rem;
            font-family: inherit; font-size: 0.9rem;
        }
        .form-group input:focus, .form-group textarea:focus { outline: none; border-color: var(--accent); }
        .form-group textarea { resize: vertical; min-height: 80px; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .modal-actions { display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem; }
        .btn-primary {
            background: var(--accent); color: #fff; border: none;
            padding: 0.55rem 1.2rem; border-radius: 5px; cursor: pointer;
            font-family: inherit; font-size: 0.9rem; font-weight: 500;
        }
        .btn-primary:hover { background: var(--accent-h); }
        .btn-secondary {
            background: var(--surface2); color: var(--text);
            border: 1px solid var(--border); padding: 0.55rem 1.2rem;
            border-radius: 5px; cursor: pointer; font-family: inherit; font-size: 0.9rem;
        }
        .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }

        /* ── Metadata search panel (inside modal) ── */
        .match-bar {
            display: flex; align-items: center; justify-content: space-between;
            border-top: 1px solid var(--border); padding-top: 1.25rem; margin-top: 1.25rem;
        }
        .match-bar span { font-size: 0.82rem; color: var(--muted); }
        .btn-change-match {
            background: none; border: 1px solid var(--border); color: var(--muted);
            padding: 0.3rem 0.75rem; border-radius: 5px; font-size: 0.82rem;
            cursor: pointer; font-family: inherit; transition: border-color 0.15s, color 0.15s;
        }
        .btn-change-match:hover { border-color: var(--accent); color: var(--accent); }
        .search-panel { margin-top: 1rem; }
        .provider-tabs { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
        .provider-tab {
            background: var(--surface2); border: 1px solid var(--border); border-radius: 20px;
            padding: 0.25rem 0.75rem; font-size: 0.8rem; cursor: pointer; color: var(--muted);
            font-family: inherit; transition: all 0.15s;
        }
        .provider-tab:hover { border-color: var(--accent); color: var(--text); }
        .provider-tab.active { border-color: var(--accent); color: var(--accent); background: rgba(91,156,246,0.1); }
        .search-input-row { display: flex; gap: 0.5rem; margin-bottom: 0.75rem; }
        .search-input-row input, #search-author {
            flex: 1; background: var(--surface2); border: 1px solid var(--border);
            border-radius: 5px; color: var(--text); padding: 0.5rem 0.75rem;
            font-family: inherit; font-size: 0.9rem; width: 100%;
        }
        .search-input-row input:focus, #search-author:focus { outline: none; border-color: var(--accent); }
        .search-results { display: flex; flex-direction: column; gap: 0.4rem; max-height: 280px; overflow-y: auto; }
        .search-result-card {
            display: flex; gap: 0.75rem; align-items: center;
            background: var(--surface2); border: 1px solid var(--border);
            border-radius: 6px; padding: 0.5rem 0.75rem; cursor: pointer;
            transition: border-color 0.15s;
        }
        .search-result-card:hover { border-color: var(--accent); }
        .search-result-card.selected { border-color: var(--accent); background: rgba(91,156,246,0.08); }
        .result-thumb {
            width: 36px; height: 54px; object-fit: cover; border-radius: 3px;
            flex-shrink: 0; background: var(--border);
        }
        .result-info { flex: 1; min-width: 0; }
        .result-title { font-size: 0.88rem; font-weight: 500; }
        .result-meta  { font-size: 0.78rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .search-empty { font-size: 0.85rem; color: var(--muted); text-align: center; padding: 1rem; }

        /* ── Item scan progress bar ── */
        @keyframes scan-sweep {
            0%   { transform: translateX(-200%); }
            100% { transform: translateX(400%); }
        }
        .item-row.item-scanning {
            border-color: var(--accent);
            position: relative;
            overflow: hidden;
        }
        .item-row.item-scanning::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0;
            height: 2px;
            width: 35%;
            background: linear-gradient(90deg,
                transparent 0%,
                var(--accent) 35%,
                var(--accent-h) 65%,
                transparent 100%);
            animation: scan-sweep 1.3s ease-in-out infinite;
        }
        .item-row.item-scanned { border-color: rgba(74,222,128,0.45); transition: border-color 0.4s; }
        .item-row.item-scanned::after { display: none; }

        /* ── No-metadata indicator ── */
        .meta-pending::before {
            content: '';
            width: 5px; height: 5px;
            border-radius: 50%;
            background: rgba(251, 146, 60, 0.55);
            flex-shrink: 0;
        }

        /* ── Expandable list rows ── */
        .item-expandable { display: flex; flex-direction: column; }
        .item-row--expandable { cursor: pointer; user-select: none; }
        .item-row--expandable .expand-chevron {
            font-size: 0.85rem; color: var(--muted); flex-shrink: 0;
            display: inline-block; transition: transform 0.2s;
        }
        .item-row--expandable.expand-open .expand-chevron { transform: rotate(90deg); }
        .expand-open-wrap .item-row { border-bottom-left-radius: 0 !important; border-bottom-right-radius: 0 !important; }
        .expand-open-wrap .item-menu-btn { border-bottom-right-radius: 0 !important; }
        .item-expand-panel {
            display: none;
            border: 1px solid var(--border); border-top: none;
            border-radius: 0 0 6px 6px;
            background: var(--surface2); overflow: hidden;
        }
        .item-expand-panel.open { display: block; }
        .item-expand-child {
            display: flex; align-items: center; gap: 0.75rem;
            padding: 0.45rem 1rem 0.45rem 2.75rem;
            text-decoration: none; color: var(--text); font-size: 0.87rem;
            border-bottom: 1px solid var(--border); transition: background 0.1s;
        }
        .item-expand-child:last-child { border-bottom: none; }
        .item-expand-child:hover { background: rgba(91,156,246,0.05); color: var(--accent); }
        .item-expand-child-name { flex: 1; }
        .item-expand-child-meta { font-size: 0.78rem; color: var(--muted); white-space: nowrap; }
        .item-expand-loading { padding: 0.6rem 1rem 0.6rem 2.75rem; color: var(--muted); font-size: 0.85rem; }

        /* ── Toast ── */
        #toast {
            position: fixed; bottom: 1.5rem; right: 1.5rem;
            background: var(--surface2); border: 1px solid var(--border);
            padding: 0.75rem 1.25rem; border-radius: 8px;
            font-size: 0.9rem; opacity: 0; transition: opacity 0.3s;
            pointer-events: none; z-index: 999;
        }
        #toast.show { opacity: 1; }

        /* ── Browse page header ── */
        .browse-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
        .browse-header-left  { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
        .browse-header-left h1 { margin-bottom: 0; }
        .browse-header-right { display: flex; gap: 0.5rem; align-items: center; flex-shrink: 0; flex-wrap: wrap; }

        /* ── Nav mobile action buttons (shown in hamburger dropdown on small screens) ── */
        .nav-links-actions-wrap { display: none; }
        .nav-links-actions { display: flex; flex-direction: column; gap: 0.4rem; padding: 0 0 0.5rem; }
        .nav-action-btn {
            background: var(--surface2); border: 1px solid var(--border);
            color: var(--text); padding: 0.65rem 1.5rem; border-radius: 6px;
            font-size: 0.88rem; cursor: pointer; font-family: inherit;
            text-align: left; width: 100%; height: auto;
            transition: background 0.15s, border-color 0.15s, color 0.15s;
        }
        .nav-action-btn:hover { background: var(--surface); border-color: var(--muted); }
        .nav-action-btn.btn-scan:hover { background: var(--accent); border-color: var(--accent); color: #fff; }

        /* ── Responsive: ≤ 640px (phones and small tablets) ── */
        @media (max-width: 640px) {
            main { padding: 1rem; }
            h1 { font-size: 1.3rem; margin-bottom: 1rem; }

            /* Hide desktop nav action buttons — they move into the hamburger dropdown */
            .nav-actions .btn-upload,
            .nav-actions .btn-scan,
            .nav-actions #btn-rd { display: none; }
            .nav-links-actions-wrap { display: block; }

            /* Browse page header: stack vertically */
            .browse-header { flex-direction: column; align-items: flex-start; gap: 0.75rem; }

            /* Two-column form grids collapse to single column */
            .form-row { grid-template-columns: 1fr; }

            /* Stat cards: smaller minimum so two fit side-by-side on phones */
            .stat-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
        }

        /* ── Responsive: ≤ 480px (small phones) ── */
        @media (max-width: 480px) {
            main { padding: 0.75rem; }
            h1 { font-size: 1.2rem; }
            .grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
            .stat-grid { grid-template-columns: 1fr 1fr; }
            .meta-table td:first-child { width: 95px; }
            .browse-tabs { flex-wrap: wrap; }
            .people-grid { grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); }
            .item-hero { margin: 0 -0.75rem 1.75rem; }
            .item-expand-child { padding-left: 1.5rem; }
        }
    </style>
</head>
<body>
    <nav>
        <button class="nav-toggle" aria-label="Menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </button>
        <a href="/" class="brand">MediaServer</a>
        <span class="brand-ver">v{{ appVersion }}</span>
        <div class="nav-links">
            <a href="/" data-nav>Home</a>
            <a href="/library/movies" data-nav>Movies</a>
            <a href="/library/shows" data-nav>Shows</a>
            <a href="/library/music" data-nav>Music</a>
            <a href="/library/books" data-nav>Books</a>
            <a href="/people" data-nav>People</a>
            {% if authUser is defined and authUser.role == 'admin' %}
            <a href="/users" data-nav>Users</a>
            {% endif %}
            <div class="nav-links-divider"></div>
            <a href="/settings" data-nav>Settings</a>
            <a href="/logs" data-nav>Logs</a>
            <div class="nav-links-actions-wrap">
                <div class="nav-links-divider"></div>
                <div class="nav-links-actions">
                    <button class="nav-action-btn btn-upload btn-rd-toggle" id="btn-rd-mobile" style="display:none" onclick="openRdModal()">Real-Debrid</button>
                    <button class="nav-action-btn btn-upload" onclick="openUploadModal()">Upload</button>
                    <button class="nav-action-btn btn-scan" onclick="triggerScan()">Scan Library</button>
                </div>
            </div>
        </div>
        <div class="nav-actions">
            <button class="btn-upload btn-rd-toggle" onclick="openRdModal()" id="btn-rd" style="display:none">Real-Debrid</button>
            <button class="btn-upload" onclick="openUploadModal()">Upload</button>
            <button class="btn-scan" onclick="triggerScan()">Scan Library</button>
            <button class="btn-scan-reset hidden" id="btn-scan-reset" onclick="resetScan()" title="Reset stuck scan">×</button>
            {% if authUser is defined %}
            <div class="nav-profile-wrap">
                <button class="nav-profile" id="nav-profile-btn" onclick="toggleProfileMenu()" aria-label="Account">
                    {{- authUser.username|slice(0,1)|upper -}}
                </button>
                <div class="nav-profile-menu" id="nav-profile-menu">
                    <div class="nav-profile-name">{{ authUser.username }}</div>
                    <form method="POST" action="/logout" style="margin:0">
                        <button class="nav-profile-signout" type="submit">Sign out</button>
                    </form>
                </div>
            </div>
            {% endif %}
        </div>
    </nav>

    <div id="scan-progress"><div id="scan-progress-fill"></div></div>
    <div id="scan-item-label"></div>
    <script>window._scanContext = {% block scan_context %}null{% endblock %};</script>

    <main>
        {% block content %}{% endblock %}
    </main>

    <div id="toast"></div>

    {# ── Upload modal ── #}
    <div id="upload-modal-wrap" style="display:none;" onclick="if(event.target===this)closeUploadModal()">
        <div class="upload-modal-backdrop" onclick="closeUploadModal()">
            <div class="upload-modal" onclick="event.stopPropagation()">
                <button class="modal-close" onclick="closeUploadModal()" style="position:absolute;top:0.75rem;right:0.75rem;">✕</button>
                <h2>Upload Files</h2>

                <div class="upload-field">
                    <label for="upload-category">Category</label>
                    <select id="upload-category">
                        <option value="movies">Movies</option>
                        <option value="shows">Shows</option>
                        <option value="music">Music</option>
                        <option value="books" selected>Books</option>
                    </select>
                </div>

                <div class="upload-field">
                    <label for="upload-files">Files <span style="color:var(--muted);font-size:0.78rem;">(multiple allowed)</span></label>
                    <input type="file" id="upload-files" multiple>
                </div>

                <div class="upload-actions">
                    <button class="btn-refresh" onclick="closeUploadModal()">Cancel</button>
                    <button class="btn-play-hero" id="upload-submit-btn" onclick="submitUpload()" style="font-size:0.85rem;padding:0.4rem 1rem;">Upload &amp; Place</button>
                </div>

                <div class="upload-results" id="upload-results" style="display:none;"></div>
            </div>
        </div>
    </div>


    <!-- ── Real-Debrid modal ── -->
    <div id="rd-modal-wrap" style="display:none;" onclick="if(event.target===this)closeRdModal()">
        <div class="upload-modal-backdrop" onclick="closeRdModal()">
            <div class="upload-modal" onclick="event.stopPropagation()" style="max-width:520px;">
                <button class="modal-close" onclick="closeRdModal()" style="position:absolute;top:0.75rem;right:0.75rem;">✕</button>
                <h2>Add via Real-Debrid</h2>

                <div class="upload-field">
                    <label for="rd-input">Magnet link or direct URL</label>
                    <input type="text" id="rd-input" placeholder="magnet:?xt=… or https://…"
                        style="width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.88rem;padding:0.45rem 0.75rem;font-family:monospace;">
                </div>

                <div class="upload-field">
                    <label for="rd-category">Save to</label>
                    <select id="rd-category">
                        <option value="movies">Movies</option>
                        <option value="shows">Shows</option>
                        <option value="music">Music</option>
                        <option value="books">Books</option>
                    </select>
                </div>

                <div class="upload-actions">
                    <button class="btn-refresh" onclick="closeRdModal()">Cancel</button>
                    <button class="btn-play-hero" id="rd-submit-btn" onclick="submitRd()" style="font-size:0.85rem;padding:0.4rem 1rem;">Add &amp; Download</button>
                </div>

                <div id="rd-queue" style="margin-top:1.25rem;display:none;">
                    <div style="font-size:0.78rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.6rem;">Active Downloads</div>
                    <div id="rd-queue-rows"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Context menu dropdown (singleton) ── -->
    <div id="item-dropdown" class="item-dropdown" style="display:none;"></div>

    <!-- ── Edit metadata modal ── -->
    <div id="edit-modal" class="modal-overlay" style="display:none;" onclick="onModalOverlayClick(event)">
        <div class="modal-panel" onclick="event.stopPropagation()">
            <div class="modal-head">
                <h2>Edit Metadata</h2>
                <button class="modal-close" onclick="closeEditModal()">✕</button>
            </div>
            <form id="edit-form" onsubmit="submitEditForm(event)">
                <input type="hidden" id="edit-id">
                <input type="hidden" id="edit-media-type">
                <div class="form-row">
                    <div class="form-group">
                        <label>Title</label>
                        <input type="text" id="edit-title" name="title">
                    </div>
                    <div class="form-group">
                        <label>Year</label>
                        <input type="number" id="edit-year" name="year" min="1900" max="2100">
                    </div>
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea id="edit-description" name="description"></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Author / Artist</label>
                        <input type="text" id="edit-author" name="author">
                    </div>
                    <div class="form-group">
                        <label>Series / Album</label>
                        <input type="text" id="edit-series" name="series">
                    </div>
                </div>
                <div id="edit-series-order-row" class="form-group" style="display:none;">
                    <label>Order in Series</label>
                    <input type="number" id="edit-series-order" name="series_order" step="0.1" min="0" placeholder="e.g. 3 or 4.5">
                </div>
                <div id="edit-season-episode-row" class="form-row">
                    <div class="form-group">
                        <label>Season</label>
                        <input type="number" id="edit-season" name="season" min="1">
                    </div>
                    <div class="form-group">
                        <label>Episode</label>
                        <input type="number" id="edit-episode" name="episode" min="1">
                    </div>
                </div>
                <div class="form-group">
                    <label>Poster URL</label>
                    <input type="text" id="edit-poster" name="poster" placeholder="https://… or leave blank">
                </div>

                <!-- Matched metadata section -->
                <div class="match-bar">
                    <span id="match-label">No external match</span>
                    <button type="button" class="btn-change-match" onclick="toggleSearchPanel()">Change Matched Metadata</button>
                </div>
                <div id="search-panel" class="search-panel" style="display:none;">
                    <div id="provider-tabs" class="provider-tabs"></div>
                    <div class="search-input-row">
                        <input type="text" id="search-query" placeholder="Title…" onkeydown="if(event.key==='Enter'){event.preventDefault();runMetadataSearch();}">
                        <button type="button" class="btn-secondary" onclick="runMetadataSearch()">Search</button>
                    </div>
                    <div id="search-author-row" style="display:none; margin-bottom:0.75rem;">
                        <input type="text" id="search-author" placeholder="Author (optional)…" style="width:100%;" onkeydown="if(event.key==='Enter'){event.preventDefault();runMetadataSearch();}">
                    </div>
                    <div id="search-results" class="search-results"></div>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn-secondary" onclick="closeEditModal()">Cancel</button>
                    <button type="submit" class="btn-primary" id="edit-save-btn">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let scanPollTimer   = null;
        let wasScanning     = false;
        let activeTileType  = null;
        let doneTileTypes   = new Set();
        let spinItemId      = null;
        let spinGroupName   = null;
        let spinScanName    = null;
        let isSoftReloading = false;

        // Helper — operate on every .btn-scan element (desktop nav + mobile hamburger)
        function eachScanBtn(fn) { document.querySelectorAll('.btn-scan').forEach(fn); }

        // Swap <main> content in-place without a full page reload.
        // Only fires on pages where the content is library-related.
        function softReloadMain() {
            const p = window.location.pathname;
            if (!p.startsWith('/library/') && p !== '/') return;
            if (isSoftReloading) return;
            isSoftReloading = true;
            // Capture URL now; abort if user navigated elsewhere before fetch completes
            const targetHref = window.location.href;
            fetch(targetHref)
                .then(r => r.text())
                .then(html => {
                    if (window.location.href !== targetHref) return; // user navigated away
                    const doc     = new DOMParser().parseFromString(html, 'text/html');
                    const newMain = doc.querySelector('main');
                    const curMain = document.querySelector('main');
                    if (newMain && curMain) {
                        const sy = window.scrollY;
                        curMain.innerHTML = newMain.innerHTML;
                        // innerHTML does NOT execute <script> tags — clone and re-insert each one
                        curMain.querySelectorAll('script').forEach(old => {
                            const s = document.createElement('script');
                            s.textContent = old.textContent;
                            old.replaceWith(s);
                        });
                        window.scrollTo(0, sy);
                    }
                })
                .catch(() => {})
                .finally(() => { isSoftReloading = false; });
        }

        const TYPE_LABELS = { movies: 'Movies', shows: 'Shows', music: 'Music', books: 'Books' };

        function getScanContext() {
            if (window._scanContext) return window._scanContext;
            const path = window.location.pathname;
            if (path.startsWith('/library/audiobooks')) {
                const seg = path.split('/')[3];
                return { type: 'books', group: seg ? decodeURIComponent(seg) : null };
            }
            const m = path.match(/^\/library\/(movies|shows|music|books)(?:\/([^/?]+))?/);
            if (!m) return { type: null, group: null };
            return { type: m[1], group: m[2] ? decodeURIComponent(m[2]) : null };
        }

        function getScanBtnLabel() {
            const { type, group } = getScanContext();
            if (!type) return 'Scan Library';
            if (group) return 'Scan ' + group;
            return 'Scan ' + TYPE_LABELS[type];
        }

        // Set button label to reflect current page on load
        (function () { eachScanBtn(b => { b.textContent = getScanBtnLabel(); }); })();

        // ── Tile helpers ──────────────────────────────────────────────────

        function tileFill(type, pct) {
            const card = document.querySelector(`.stat-card[data-type="${type}"]`);
            if (!card) return;
            const fill = card.querySelector('.tile-progress-fill');
            if (fill) fill.style.width = pct + '%';
        }

        function tileSetActive(type, isMetaPhase) {
            const card = document.querySelector(`.stat-card[data-type="${type}"]`);
            if (!card) return;
            card.classList.remove('tile-done', 'tile-meta');
            card.classList.add('tile-active');
            if (isMetaPhase) card.classList.add('tile-meta');
        }

        function tileSetDone(type) {
            const card = document.querySelector(`.stat-card[data-type="${type}"]`);
            if (!card) return;
            card.classList.remove('tile-active', 'tile-meta');
            card.classList.add('tile-done');
        }

        // ── Item spinners ─────────────────────────────────────────────────

        function setSpinner(sel) {
            document.querySelectorAll(sel).forEach(el => el.classList.add('item-scanning'));
        }

        function clearSpinner(sel, flash) {
            document.querySelectorAll(sel).forEach(el => {
                el.classList.remove('item-scanning');
                if (flash) {
                    el.classList.add('item-scanned');
                    setTimeout(() => el.classList.remove('item-scanned'), 1500);
                }
            });
        }

        function clearAllSpinners() {
            spinItemId    = null;
            spinGroupName = null;
            spinScanName  = null;
            document.querySelectorAll('.item-scanning, .item-scanned').forEach(el =>
                el.classList.remove('item-scanning', 'item-scanned')
            );
        }

        function clearTileStates() {
            document.querySelectorAll('.stat-card[data-type]').forEach(c => {
                c.classList.remove('tile-active', 'tile-done', 'tile-meta');
                const fill = c.querySelector('.tile-progress-fill');
                if (fill) fill.style.width = '0%';
            });
            activeTileType = null;
            doneTileTypes.clear();
            clearAllSpinners();
            const bar = document.getElementById('scan-progress');
            if (bar) {
                bar.style.display = 'none';
                bar.classList.remove('indeterminate');
                document.getElementById('scan-progress-fill').style.width = '0%';
            }
            const lbl = document.getElementById('scan-item-label');
            if (lbl) lbl.style.display = 'none';
        }

        function setScanResetVisible(visible) {
            const btn = document.getElementById('btn-scan-reset');
            if (btn) btn.classList.toggle('hidden', !visible);
        }

        function resetScan() {
            fetch('/scan/reset', { method: 'POST' })
                .then(r => r.json())
                .then(() => {
                    clearTimeout(scanPollTimer);
                    clearTileStates();
                    setScanResetVisible(false);
                    eachScanBtn(b => { b.disabled = false; b.textContent = getScanBtnLabel(); });
                    showToast('Scan state reset');
                })
                .catch(() => showToast('Reset failed'));
        }

        // ── Scan button text ──────────────────────────────────────────────

        function scanBtnText(text) { eachScanBtn(b => { b.textContent = text; }); }

        // ── Polling ───────────────────────────────────────────────────────

        function triggerScan() {
            eachScanBtn(b => { b.textContent = 'Starting…'; b.disabled = true; });
            const { type, group } = getScanContext();

            const payload = type ? { type, ...(group ? { group } : {}) } : null;
            fetch('/scan', {
                method:  'POST',
                headers: payload ? { 'Content-Type': 'application/json' } : {},
                body:    payload ? JSON.stringify(payload) : null,
            })
                .then(r => r.json())
                .then(d => {
                    if (d.error) {
                        showToast(d.error);
                        eachScanBtn(b => { b.textContent = getScanBtnLabel(); b.disabled = false; });
                    } else {
                        startPolling();
                    }
                })
                .catch(() => {
                    showToast('Failed to start scan');
                    eachScanBtn(b => { b.textContent = getScanBtnLabel(); b.disabled = false; });
                });
        }

        function startPolling() {
            wasScanning = false;
            clearTileStates();
            eachScanBtn(b => { b.textContent = 'Starting…'; b.disabled = true; });
            setScanResetVisible(true);
            clearTimeout(scanPollTimer);
            pollStatus();
        }

        function pollStatus() {
            fetch('/scan/status')
                .then(r => r.json())
                .then(d => {
                    // Live-update count chips on home tiles
                    Object.entries(d.counts ?? {}).forEach(([type, count]) => {
                        const el = document.querySelector(`[data-count="${type}"]`);
                        if (el) el.textContent = count;
                    });

                    if (d.scanning) {
                        wasScanning = true;
                        const isMeta      = d.phase === 'metadata';
                        const isPeople    = d.phase === 'people';
                        const typeTotals  = d.type_totals ?? {};
                        const counts      = d.counts      ?? {};
                        const cap         = s => s.charAt(0).toUpperCase() + s.slice(1);

                        // ── Progress bar ──
                        const bar  = document.getElementById('scan-progress');
                        const fill = document.getElementById('scan-progress-fill');
                        bar.style.display = 'block';
                        if (isMeta && d.total > 0) {
                            const metaPct = Math.min(100, Math.round(d.processed / d.total * 100));
                            bar.classList.remove('indeterminate');
                            fill.style.width = metaPct + '%';
                        } else {
                            bar.classList.add('indeterminate');
                        }

                        if (d.current_type) {
                            // Transition previous active tile to done
                            if (activeTileType && activeTileType !== d.current_type) {
                                doneTileTypes.add(activeTileType);
                                tileSetDone(activeTileType);
                                tileFill(activeTileType, 100);
                            }
                            activeTileType = d.current_type;
                            tileSetActive(d.current_type, isMeta);

                            // Per-tile progress during file indexing
                            if (!isMeta && typeTotals[d.current_type] > 0) {
                                const pct = Math.min(100, Math.round(
                                    (counts[d.current_type] ?? 0) / typeTotals[d.current_type] * 100
                                ));
                                tileFill(d.current_type, pct);
                            }

                            // Button text
                            if (d.phase === 'starting') {
                                scanBtnText('Starting…');
                            } else if (isMeta) {
                                const detail = d.total > 0
                                    ? ` · ${d.processed}/${d.total}`
                                    : '…';
                                scanBtnText(`Metadata · ${cap(d.current_type)}${detail}`);
                            } else {
                                const found = (d.stats?.added ?? 0) + (d.stats?.updated ?? 0);
                                const foundStr = found > 0 ? ` · ${found} found` : '';
                                scanBtnText(`Indexing ${cap(d.current_type)}…${foundStr}`);
                            }
                        } else if (d.phase === 'people') {
                            scanBtnText('Syncing people…');
                        } else {
                            scanBtnText('Starting…');
                        }

                        // ── Item name label ──
                        const lbl = document.getElementById('scan-item-label');
                        if (lbl) {
                            let labelText = null;
                            if (d.phase === 'metadata') {
                                labelText = d.current_item_name || d.current_group || null;
                            } else if (d.phase === 'scanning') {
                                labelText = d.current_scan_name || null;
                            }
                            if (labelText) {
                                lbl.textContent   = labelText;
                                lbl.style.display = 'block';
                            } else {
                                lbl.style.display = 'none';
                            }
                        }

                        // ── Per-item spinners ──
                        const newItemId   = d.current_item_id  ?? null;
                        const newGroup    = d.current_group    ?? null;
                        const newScanName = d.current_scan_name ?? null;

                        if (newItemId !== spinItemId) {
                            if (spinItemId !== null) clearSpinner(`[data-media-id="${spinItemId}"]`, true);
                            spinItemId = newItemId;
                            if (spinItemId !== null) setSpinner(`[data-media-id="${spinItemId}"]`);
                        }
                        if (newGroup !== spinGroupName) {
                            if (spinGroupName !== null) clearSpinner(`[data-group-name="${spinGroupName}"]`, true);
                            spinGroupName = newGroup;
                            if (spinGroupName !== null) setSpinner(`[data-group-name="${spinGroupName}"]`);
                        }
                        if (newScanName !== spinScanName) {
                            if (spinScanName !== null) clearSpinner(`[data-scan-name="${spinScanName}"]`, true);
                            spinScanName = newScanName;
                            if (spinScanName !== null) setSpinner(`[data-scan-name="${spinScanName}"]`);
                        }

                        scanPollTimer = setTimeout(pollStatus, 1000);
                    } else {
                        clearTileStates();
                        setScanResetVisible(false);

                        eachScanBtn(b => { b.disabled = false; });

                        if (d.error && wasScanning) {
                            wasScanning = false;
                            showToast('Scan failed: ' + d.error, 8000);
                            eachScanBtn(b => { b.textContent = '✗ Scan failed'; });
                            setTimeout(() => { eachScanBtn(b => { b.textContent = getScanBtnLabel(); }); }, 5000);
                        } else if (wasScanning) {
                            wasScanning = false;
                            eachScanBtn(b => { b.textContent = '✓ Scan complete'; });
                            softReloadMain();
                            setTimeout(() => { eachScanBtn(b => { b.textContent = getScanBtnLabel(); }); }, 3000);
                        } else {
                            eachScanBtn(b => { b.textContent = getScanBtnLabel(); });
                        }
                    }
                })
                .catch(() => {
                    scanPollTimer = setTimeout(pollStatus, 2000);
                });
        }

        // ── Nav active state ──────────────────────────────────────────────

        (function () {
            const path = window.location.pathname;
            document.querySelectorAll('a[data-nav]').forEach(a => {
                const href   = a.getAttribute('href');
                const active = href === '/' ? path === '/' : path.startsWith(href);
                if (active) a.classList.add('active');
            });
        })();

        // ── Resume polling if scan was already running ─────────────────────
        (function () {
            fetch('/scan/status')
                .then(r => r.json())
                .then(d => {
                    if (d.scanning) {
                        eachScanBtn(b => { b.disabled = true; });
                        setScanResetVisible(true);
                        pollStatus();
                    }
                })
                .catch(() => {});
        })();

        // ── M4B chapter seek ──────────────────────────────────────────────────
        function seekChapter(btn) {
            const audio = document.getElementById('audio-player');
            if (!audio) return;
            audio.currentTime = parseFloat(btn.dataset.start);
            audio.play();
            document.querySelectorAll('.chapter-row').forEach(r => r.classList.remove('chapter-active'));
            btn.classList.add('chapter-active');
        }

        (function () {
            const audio = document.getElementById('audio-player');
            if (!audio) return;
            const rows = Array.from(document.querySelectorAll('.chapter-row'));
            if (!rows.length) return;
            audio.addEventListener('timeupdate', () => {
                const t = audio.currentTime;
                let active = rows[0];
                for (const row of rows) {
                    if (parseFloat(row.dataset.start) <= t) active = row;
                }
                rows.forEach(r => r.classList.remove('chapter-active'));
                active.classList.add('chapter-active');
            });
        })();

        function showToast(msg, duration = 4000) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), duration);
        }

        // ── Upload modal ──────────────────────────────────────────────────────

        function openUploadModal() {
            document.getElementById('upload-results').style.display = 'none';
            document.getElementById('upload-results').innerHTML     = '';
            document.getElementById('upload-files').value           = '';
            document.getElementById('upload-modal-wrap').style.display = '';
            document.getElementById('upload-submit-btn').disabled   = false;
            document.getElementById('upload-submit-btn').textContent = 'Upload & Place';
        }

        function closeUploadModal() {
            document.getElementById('upload-modal-wrap').style.display = 'none';
        }

        function toggleProfileMenu() {
            const menu = document.getElementById('nav-profile-menu');
            if (menu) menu.classList.toggle('open');
        }
        document.addEventListener('click', function (e) {
            const btn  = document.getElementById('nav-profile-btn');
            const menu = document.getElementById('nav-profile-menu');
            if (menu && menu.classList.contains('open') && btn && !btn.contains(e.target) && !menu.contains(e.target)) {
                menu.classList.remove('open');
            }
            const navLinks = document.querySelector('.nav-links');
            const navToggle = document.querySelector('.nav-toggle');
            if (navLinks && navLinks.classList.contains('open') && !navLinks.contains(e.target) && navToggle && !navToggle.contains(e.target)) {
                navLinks.classList.remove('open');
            }
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && document.getElementById('upload-modal-wrap').style.display !== 'none') {
                closeUploadModal();
            }
        });

        function submitUpload() {
            const fileInput = document.getElementById('upload-files');
            const category  = document.getElementById('upload-category').value;
            const files     = fileInput.files;

            if (!files || files.length === 0) {
                showToast('Please select at least one file.');
                return;
            }

            const btn = document.getElementById('upload-submit-btn');
            btn.disabled    = true;
            btn.textContent = 'Uploading…';

            const resultsEl = document.getElementById('upload-results');
            resultsEl.style.display = '';
            resultsEl.innerHTML = '';

            // Show per-file pending rows immediately
            Array.from(files).forEach(f => {
                resultsEl.innerHTML += `
                    <div class="upload-result-row" id="urow-${CSS.escape(f.name)}">
                        <span class="upload-result-icon"><span class="upload-spinner"></span></span>
                        <div><div class="upload-result-name">${escHtml(f.name)}</div></div>
                    </div>`;
            });

            const form = new FormData();
            form.append('category', category);
            Array.from(files).forEach(f => form.append('files[]', f));

            fetch('/upload', { method: 'POST', body: form })
                .then(r => r.json())
                .then(results => {
                    resultsEl.innerHTML = '';
                    results.forEach(r => {
                        const icon  = r.success ? '✓' : '✗';
                        const color = r.success ? 'color:var(--accent)' : 'color:#e05';
                        const sub   = r.success
                            ? `<div class="upload-result-dest">→ ${escHtml(r.destination)}</div>`
                            : `<div class="upload-result-err">${escHtml(r.error || 'Unknown error')}</div>`;
                        resultsEl.innerHTML += `
                            <div class="upload-result-row">
                                <span class="upload-result-icon" style="${color}">${icon}</span>
                                <div>
                                    <div class="upload-result-name">${escHtml(r.filename)}</div>
                                    ${sub}
                                    ${r.matched ? `<div class="upload-result-dest">Matched: ${escHtml(r.matched)}</div>` : ''}
                                </div>
                            </div>`;
                    });

                    const ok = results.filter(r => r.success).length;
                    btn.disabled    = false;
                    btn.textContent = ok > 0 ? 'Upload More' : 'Try Again';
                    if (ok > 0) showToast(ok + ' file' + (ok !== 1 ? 's' : '') + ' uploaded and placed.');
                })
                .catch(err => {
                    resultsEl.innerHTML = '<div class="upload-result-row" style="color:#e05;">Upload failed: ' + escHtml(String(err)) + '</div>';
                    btn.disabled    = false;
                    btn.textContent = 'Try Again';
                });
        }

        function escHtml(s) {
            return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        // ── Expandable rows ───────────────────────────────────────────────────

        window.toggleExpand = async function(rowEl) {
            const rawPath   = rowEl.dataset.expandPath;
            const childType = rowEl.dataset.expandType;
            const wrap      = rowEl.closest('.item-expandable');
            if (!wrap) return;
            const panel   = wrap.querySelector('.item-expand-panel');
            const rowWrap = wrap.querySelector('.item-row-wrap');
            if (!panel) return;

            const isOpen = panel.classList.contains('open');
            rowEl.classList.toggle('expand-open', !isOpen);
            panel.classList.toggle('open', !isOpen);
            if (rowWrap) rowWrap.classList.toggle('expand-open-wrap', !isOpen);

            if (!isOpen && !panel.dataset.loaded) {
                panel.dataset.loaded = '1';
                panel.innerHTML = '<div class="item-expand-loading">Loading…</div>';
                try {
                    const apiUrl = encodeURI('/api/children/' + childType + '/' + rawPath);
                    const res    = await fetch(apiUrl);
                    const items  = await res.json();
                    panel.innerHTML = renderExpandChildren(items, childType);
                } catch (e) {
                    panel.innerHTML = '<div class="item-expand-loading" style="color:#e05">Failed to load</div>';
                }
            }
        };

        function renderExpandChildren(items, type) {
            if (!items || !items.length) {
                return '<div class="item-expand-loading">Nothing here</div>';
            }
            return items.map(function(item) {
                const urlPath = (item.url_path || '').split('/').map(encodeURIComponent).join('/');
                const url     = '/library/' + type + '/' + urlPath;
                const name    = escHtml(item.title || item.name || '');
                let meta = '';
                if (type === 'shows' && item.episode != null) {
                    meta = 'E' + String(item.episode).padStart(2, '0');
                } else if (type === 'music' && item.series_order != null) {
                    meta = String(item.series_order);
                } else if (type === 'books') {
                    if (item.series_order != null) {
                        const n = parseFloat(item.series_order);
                        meta = '#' + (n % 1 === 0 ? n : n.toFixed(1));
                    } else if (item.year) {
                        meta = String(item.year);
                    }
                }
                const imgHtml = item.poster
                    ? `<img src="${escHtml(item.poster)}" style="width:28px;height:42px;object-fit:cover;border-radius:2px;flex-shrink:0;" alt="">`
                    : '';
                return `<a href="${escHtml(url)}" class="item-expand-child">${imgHtml}<span class="item-expand-child-name">${name}</span><span class="item-expand-child-meta">${escHtml(meta)}</span></a>`;
            }).join('');
        }

    </script>

    {% block scripts %}{% endblock %}

    <script>
    // ── Real-Debrid ───────────────────────────────────────────────────────────

    let rdPollTimer = null;

    (function detectRd() {
        fetch('/rd/queue')
            .then(r => r.json())
            .then(rows => {
                // Show all RD toggle buttons (RD is configured if the endpoint responds without a 503)
                document.querySelectorAll('.btn-rd-toggle').forEach(b => { b.style.display = ''; });
                if (rows.length) {
                    renderRdQueue(rows);
                    const queueEl = document.getElementById('rd-queue');
                    if (queueEl) queueEl.style.display = '';
                }
            })
            .catch(() => {}); // RD not configured — buttons stay hidden
    })();

    function openRdModal() {
        document.getElementById('rd-input').value = '';
        document.getElementById('rd-modal-wrap').style.display = '';
        document.getElementById('rd-submit-btn').disabled = false;
        document.getElementById('rd-submit-btn').textContent = 'Add & Download';
        loadRdQueue();
    }

    function closeRdModal() {
        document.getElementById('rd-modal-wrap').style.display = 'none';
        clearTimeout(rdPollTimer);
    }

    function submitRd() {
        const input    = document.getElementById('rd-input').value.trim();
        const category = document.getElementById('rd-category').value;
        if (!input) { showToast('Enter a magnet link or URL'); return; }

        const btn = document.getElementById('rd-submit-btn');
        btn.disabled = true;
        btn.textContent = 'Adding…';

        const body = input.startsWith('magnet:')
            ? { magnet: input, category }
            : { url:    input, category };

        fetch('/rd/add', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify(body),
        })
            .then(r => r.json())
            .then(d => {
                if (d.error) {
                    showToast('RD error: ' + d.error);
                    btn.disabled = false;
                    btn.textContent = 'Add & Download';
                    return;
                }
                document.getElementById('rd-input').value = '';
                btn.disabled = false;
                btn.textContent = 'Add & Download';
                loadRdQueue();
                showToast('Added to Real-Debrid — downloading…');
            })
            .catch(() => {
                showToast('Failed to add');
                btn.disabled = false;
                btn.textContent = 'Add & Download';
            });
    }

    function loadRdQueue() {
        fetch('/rd/queue')
            .then(r => r.json())
            .then(rows => {
                const wrap = document.getElementById('rd-queue');
                const list = document.getElementById('rd-queue-rows');
                if (!rows.length) { wrap.style.display = 'none'; return; }
                wrap.style.display = '';
                renderRdQueue(rows);
                const active = rows.some(r => !['done','error'].includes(r.status));
                if (active) rdPollTimer = setTimeout(loadRdQueue, 4000);
            })
            .catch(() => {});
    }

    function renderRdQueue(rows) {
        const list = document.getElementById('rd-queue-rows');
        if (!list) return;
        list.innerHTML = rows.map(r => {
            const pct      = Math.round(r.progress ?? 0);
            const isDone   = r.status === 'done';
            const isErr    = r.status === 'error';
            const icon     = isDone ? '✓' : isErr ? '✗' : '⟳';
            const color    = isDone ? 'var(--accent)' : isErr ? '#f87171' : 'var(--muted)';
            const label    = r.filename || r.id;
            const sub      = isErr
                ? (r.error || 'Error')
                : isDone
                    ? r.category
                    : (r.rd_status ?? r.status) + (pct && !isDone ? ' · ' + pct + '%' : '');
            return `<div class="upload-result-row">
                <span class="upload-result-icon" style="color:${color}">${icon}</span>
                <div style="flex:1;min-width:0;">
                    <div class="upload-result-name" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(label)}</div>
                    <div class="upload-result-dest">${escHtml(sub)}</div>
                    ${!isDone && !isErr && pct ? `<div style="height:2px;background:var(--border);border-radius:1px;margin-top:4px;"><div style="width:${pct}%;height:100%;background:var(--accent);border-radius:1px;transition:width 1s;"></div></div>` : ''}
                </div>
                ${isDone || isErr ? `<button onclick="removeRdItem('${escHtml(r.id)}')" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:1rem;padding:0 0.3rem;" title="Dismiss">✕</button>` : ''}
            </div>`;
        }).join('');
    }

    function removeRdItem(id) {
        fetch('/rd/' + encodeURIComponent(id), { method: 'DELETE' })
            .then(() => loadRdQueue())
            .catch(() => {});
    }
    </script>

    <script>
    // ── Context menu ─────────────────────────────────────────────────────────

    const dropdown    = document.getElementById('item-dropdown');
    let   activeTrigger = null;

    function openItemMenu(event, btn) {
        event.preventDefault();
        event.stopPropagation();

        if (activeTrigger === btn && dropdown.style.display !== 'none') {
            closeDropdown(); return;
        }
        closeDropdown();

        const id    = btn.dataset.id    || null;
        const type  = btn.dataset.type  || '';
        const group = btn.dataset.group || null;
        const col   = btn.dataset.col   || null;
        const label = btn.dataset.label || '';

        dropdown.innerHTML = '';

        if (id) {
            const edit = document.createElement('button');
            edit.textContent = 'Edit';
            edit.onclick = () => { closeDropdown(); openEditModal(id, type, label); };
            dropdown.appendChild(edit);
        }

        const del = document.createElement('button');
        del.textContent = group ? 'Delete All' : 'Delete';
        del.className   = 'dd-danger';
        del.onclick     = () => { closeDropdown(); handleDelete(id, type, group, col, label); };
        dropdown.appendChild(del);

        const rect = btn.getBoundingClientRect();
        dropdown.style.display = 'block';
        dropdown.style.top  = (rect.bottom + 4) + 'px';
        dropdown.style.left = Math.max(4, rect.right - 144) + 'px';

        btn.classList.add('active');
        activeTrigger = btn;
    }

    function closeDropdown() {
        dropdown.style.display = 'none';
        if (activeTrigger) { activeTrigger.classList.remove('active'); activeTrigger = null; }
    }

    document.addEventListener('click', e => {
        if (!dropdown.contains(e.target) && activeTrigger && !activeTrigger.contains(e.target)) closeDropdown();
    });

    // ── Delete ───────────────────────────────────────────────────────────────

    function handleDelete(id, type, group, col, label) {
        const what  = group ? `all files for "${label}"` : `"${label}"`;
        const multi = group ? ' This will delete all associated files.' : '';
        if (!confirm(`Delete ${what} from disk?${multi}\n\nThis cannot be undone.`)) return;

        const req = group
            ? fetch('/api/media/group', { method: 'DELETE', headers: {'Content-Type':'application/json'}, body: JSON.stringify({type, name: group, ...(col ? {col} : {})}) })
            : fetch('/api/media/' + id, { method: 'DELETE' });

        req.then(r => r.json()).then(d => {
            if (d.deleted !== undefined) location.reload();
            else showToast(d.error || 'Delete failed');
        }).catch(() => showToast('Delete failed'));
    }

    // ── Edit modal ───────────────────────────────────────────────────────────

    let editSelectedMatch = null;

    function openEditModal(id, type, label) {
        if (!id) { showToast('Edit not available for this item'); return; }
        editSelectedMatch = null;

        fetch('/api/media/' + id)
            .then(r => r.json())
            .then(item => {
                document.getElementById('edit-id').value          = item.id;
                document.getElementById('edit-media-type').value  = item.type;
                document.getElementById('edit-title').value       = item.title       || '';
                document.getElementById('edit-year').value        = item.year        || '';
                document.getElementById('edit-description').value = item.description || '';
                document.getElementById('edit-author').value      = item.author      || '';
                document.getElementById('edit-series').value      = item.series      || '';
                document.getElementById('edit-season').value      = item.season      || '';
                document.getElementById('edit-episode').value     = item.episode     || '';
                document.getElementById('edit-poster').value      = item.poster      || '';

                const src = item.external_source && item.external_id
                    ? item.external_source.toUpperCase() + ' #' + item.external_id
                    : 'No external match';
                document.getElementById('match-label').textContent = src;

                // Pre-fill search fields
                const isBook = ['books', 'audiobooks'].includes(item.type);
                document.getElementById('search-author-row').style.display = isBook ? 'block' : 'none';
                document.getElementById('edit-series-order-row').style.display = isBook ? 'block' : 'none';
                document.getElementById('edit-season-episode-row').style.display = isBook ? 'none' : 'block';
                document.getElementById('edit-series-order').value = item.series_order != null ? item.series_order : '';
                if (isBook) {
                    let t = item.title || item.filename || '';
                    // For audiobooks, pre-populate with ASIN if present so Audnexus can find it
                    if (item.type === 'audiobooks') {
                        const asinMatch = t.match(/\b(B[0-9A-Z]{9})\b/);
                        if (asinMatch) {
                            document.getElementById('search-query').value  = asinMatch[1];
                            document.getElementById('search-author').value = item.author || '';
                        } else {
                            // No ASIN — fall through to cleaned-title path below
                            item._noAsin = true;
                        }
                    }
                    if (item.type !== 'audiobooks' || item._noAsin) {
                        if (item.author) {
                            const escapedAuthor = item.author.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                            t = t.replace(new RegExp('^' + escapedAuthor + '\\s*[-–:]\\s*', 'i'), '').trim();
                            t = t.replace(new RegExp('\\s*[-–]\\s*' + escapedAuthor + '\\s*$', 'i'), '').trim();
                            t = t.replace(new RegExp('\\s*\\(' + escapedAuthor + '\\)\\s*$', 'i'), '').trim();
                        }
                        t = t.replace(/[_:]\s*.{0,80}(?:,\s*Book\s*[\d.]+)?(?:\s*\[[^\]]{5,}\])?$/i, '').trim();
                        t = t.replace(/\s*\[[A-Z0-9]{9,13}\]\s*$/i, '').trim();
                        document.getElementById('search-query').value  = t || item.title || item.filename || '';
                        document.getElementById('search-author').value = item.author || '';
                    }
                } else {
                    document.getElementById('search-query').value  = item.show_name || item.title || item.filename || '';
                    document.getElementById('search-author').value = '';
                }
                document.getElementById('search-results').innerHTML = '';
                document.getElementById('search-panel').style.display = 'none';

                // Populate provider tabs
                const PROVIDERS = {
                    movies:     [{ label: 'TMDB',         value: 'tmdb' }],
                    shows:      [{ label: 'TMDB',         value: 'tmdb' }],
                    music:      [{ label: 'MusicBrainz',  value: 'musicbrainz' }],
                    audiobooks: [{ label: 'Audnexus',     value: 'audnexus' },
                                 { label: 'OpenLibrary',  value: 'openlibrary' }],
                    books:      [{ label: 'OpenLibrary',  value: 'openlibrary' },
                                 { label: 'Audnexus',     value: 'audnexus' }],
                };
                const providers = PROVIDERS[item.type] || [];
                const tabsEl = document.getElementById('provider-tabs');
                tabsEl.innerHTML = '';
                providers.forEach((p, i) => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.textContent = p.label;
                    btn.dataset.provider = p.value;
                    btn.className = 'provider-tab' + (i === 0 ? ' active' : '');
                    btn.onclick = () => {
                        tabsEl.querySelectorAll('.provider-tab').forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                    };
                    tabsEl.appendChild(btn);
                });
                tabsEl.style.display = providers.length > 1 ? '' : 'none';

                document.getElementById('edit-modal').style.display = 'flex';
                document.body.style.overflow = 'hidden';
            })
            .catch(() => showToast('Could not load item'));
    }

    function closeEditModal() {
        document.getElementById('edit-modal').style.display = 'none';
        document.body.style.overflow = '';
        editSelectedMatch = null;
    }

    function onModalOverlayClick(e) {
        if (e.target === document.getElementById('edit-modal')) closeEditModal();
    }

    function submitEditForm(event) {
        event.preventDefault();
        const id     = document.getElementById('edit-id').value;
        const soVal  = document.getElementById('edit-series-order').value;
        const poster = document.getElementById('edit-poster').value;

        const body = {
            title:        document.getElementById('edit-title').value,
            year:         document.getElementById('edit-year').value         || null,
            description:  document.getElementById('edit-description').value,
            author:       document.getElementById('edit-author').value,
            series:       document.getElementById('edit-series').value,
            season:       document.getElementById('edit-season').value       || null,
            episode:      document.getElementById('edit-episode').value      || null,
            series_order: soVal !== '' ? parseFloat(soVal) : null,
        };

        // When a metadata match is selected, let the match download and set the cover.
        // Only include poster in the PATCH if the user explicitly typed a URL.
        if (poster) {
            body.poster = poster;
        }

        const btn = document.getElementById('edit-save-btn');
        btn.disabled = true; btn.textContent = 'Saving…';

        // Run sequentially: PATCH fields first, then apply the metadata match.
        // Sequential ensures the match's downloaded cover is never overwritten by the PATCH.
        const doSave = editSelectedMatch
            ? fetch('/api/media/' + id, { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) })
                .then(() => fetch('/api/media/' + id + '/match', {
                    method: 'POST', headers: {'Content-Type':'application/json'},
                    body: JSON.stringify({ source: editSelectedMatch.source, external_id: editSelectedMatch.id })
                }))
            : fetch('/api/media/' + id, { method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });

        doSave
            .then(() => { closeEditModal(); location.reload(); })
            .catch(() => { showToast('Save failed'); btn.disabled = false; btn.textContent = 'Save Changes'; });
    }

    // ── Metadata search panel ─────────────────────────────────────────────────

    function toggleSearchPanel() {
        const panel = document.getElementById('search-panel');
        panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        if (panel.style.display === 'block') runMetadataSearch();
    }

    function runMetadataSearch() {
        const query     = document.getElementById('search-query').value.trim();
        const mediaType = document.getElementById('edit-media-type').value;
        const author    = document.getElementById('search-author').value.trim();
        const resultsEl = document.getElementById('search-results');

        if (!query) return;
        resultsEl.innerHTML = '<p class="search-empty">Searching…</p>';

        const activeTab = document.querySelector('#provider-tabs .provider-tab.active');
        const provider  = activeTab ? activeTab.dataset.provider : null;
        const params = { query, media_type: mediaType };
        if (author)   params.author   = author;
        if (provider) params.provider = provider;

        fetch('/api/metadata/search?' + new URLSearchParams(params))
            .then(r => r.json())
            .then(results => {
                if (!results.length) {
                    resultsEl.innerHTML = '<p class="search-empty">No results found.</p>'; return;
                }
                resultsEl.innerHTML = '';
                results.forEach(r => {
                    const card = document.createElement('div');
                    card.className = 'search-result-card';

                    const img = document.createElement('img');
                    img.className = 'result-thumb';
                    img.src = r.poster_url || '';
                    img.style.display = r.poster_url ? '' : 'none';
                    if (!r.poster_url) {
                        const placeholder = document.createElement('div');
                        placeholder.className = 'result-thumb';
                        card.appendChild(placeholder);
                    } else {
                        card.appendChild(img);
                    }

                    const info  = document.createElement('div');
                    info.className = 'result-info';
                    const title = document.createElement('div');
                    title.className = 'result-title';
                    title.textContent = r.title + (r.year ? ' (' + r.year + ')' : '');
                    const meta = document.createElement('div');
                    meta.className = 'result-meta';
                    meta.textContent = (r.description || '') + (r.source ? ' · ' + r.source.toUpperCase() : '');
                    info.appendChild(title);
                    info.appendChild(meta);
                    card.appendChild(info);

                    card.addEventListener('click', () => {
                        document.querySelectorAll('.search-result-card').forEach(c => c.classList.remove('selected'));
                        card.classList.add('selected');
                        editSelectedMatch = r;
                        document.getElementById('match-label').textContent =
                            r.source.toUpperCase() + ' #' + r.id + ' — ' + r.title;
                    });

                    resultsEl.appendChild(card);
                });
            })
            .catch(() => { resultsEl.innerHTML = '<p class="search-empty">Search failed.</p>'; });
    }
    </script>
    
    <script>
        // Theme toggle functionality
        const themeToggle = document.querySelector('.theme-toggle');
        if (themeToggle) {
            themeToggle.addEventListener('click', () => {
                document.body.classList.toggle('light-theme');
                localStorage.setItem('theme', document.body.classList.contains('light-theme') ? 'light' : 'dark');
            });
            
            // Check for saved theme preference
            if (localStorage.getItem('theme') === 'light') {
                document.body.classList.add('light-theme');
            }
        }
    </script>
</body>
</html>
