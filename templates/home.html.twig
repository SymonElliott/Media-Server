{% extends 'layout.html.twig' %}

{% block title %}MediaServer — Home{% endblock %}

{% block content %}
<style>
    /* ── Continue rows ── */
    .continue-section { margin-bottom: 2.25rem; }
    .continue-heading {
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 0.85rem;
        color: var(--text);
    }
    .continue-row {
        display: flex;
        gap: 0.75rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
        scrollbar-width: none;
    }
    .continue-row::-webkit-scrollbar { display: none; }

    .continue-card {
        flex: 0 0 auto;
        width: 148px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
        text-decoration: none;
        color: var(--text);
        display: flex;
        flex-direction: column;
        transition: border-color 0.15s, transform 0.15s;
    }
    .continue-card:hover {
        border-color: var(--accent);
        transform: translateY(-2px);
    }
    .continue-thumb {
        aspect-ratio: 2/3;
        background: var(--surface2);
        position: relative;
        overflow: hidden;
        flex-shrink: 0;
    }
    .continue-thumb--square { aspect-ratio: 1/1; }
    .continue-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .continue-thumb-icon {
        width: 100%; height: 100%;
        display: flex; align-items: center; justify-content: center;
        font-size: 3rem;
    }
    .continue-bar {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        height: 3px;
        background: rgba(255,255,255,0.12);
    }
    .continue-bar-fill { height: 100%; background: var(--accent); border-radius: 0 2px 2px 0; }
    .continue-info {
        padding: 0.55rem 0.65rem 0.6rem;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }
    .continue-title {
        font-size: 0.8rem;
        font-weight: 500;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .continue-sub {
        font-size: 0.7rem;
        color: var(--muted);
    }
    .continue-sub-ep {
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

{% set typeIcon = { movies: '🎬', shows: '📺', music: '🎵', books: '📚', audiobooks: '🎧' } %}

{% macro continue_row(items, heading, square) %}
{% if items|length > 0 %}
<div class="continue-section">
    <div class="continue-heading">{{ heading }}</div>
    <div class="continue-row">
        {% for item in items %}
        <a href="{{ item.url }}" class="continue-card">
            <div class="continue-thumb {% if square %}continue-thumb--square{% endif %}">
                {% if item.poster %}
                    <img src="{{ item.poster }}" alt="" loading="lazy">
                {% else %}
                    <div class="continue-thumb-icon">{{ typeIcon[item.type] ?? '📄' }}</div>
                {% endif %}
                <div class="continue-bar">
                    <div class="continue-bar-fill" style="width:{{ item.percent }}%"></div>
                </div>
            </div>
            <div class="continue-info">
                <div class="continue-title">
                    {% if item.show_name %}{{ item.show_name }}{% else %}{{ item.title ?? item.filename }}{% endif %}
                </div>
                <div class="continue-sub">
                    {% if item.type == 'shows' %}
                        {% if item.title %}<div class="continue-sub-ep">{{ item.title }}</div>{% endif %}
                        <div>
                            {%- if item.season and item.episode -%}
                                S{{ '%02d'|format(item.season) }}E{{ '%02d'|format(item.episode) }} ·
                            {%- endif -%}
                            {{ item.percent }}%
                        </div>
                    {% elseif item.author %}
                        {{ item.author }} · {{ item.percent }}%
                    {% else %}
                        {{ item.percent }}%
                    {% endif %}
                </div>
            </div>
        </a>
        {% endfor %}
    </div>
</div>
{% endif %}
{% endmacro %}

{% import _self as self %}

{{ self.continue_row(watching,  'Continue Watching',  false) }}
{{ self.continue_row(listening, 'Continue Listening', true)  }}
{{ self.continue_row(reading,   'Continue Reading',   false) }}

{# ── Library stats ── #}
<h1 style="margin-bottom:1rem;">Library</h1>

{% set typeConfig = {
    movies: { icon: '🎬', label: 'Movies',  unit: 'film' },
    shows:  { icon: '📺', label: 'Shows',   unit: 'episode' },
    music:  { icon: '🎵', label: 'Music',   unit: 'track' },
    books:  { icon: '📚', label: 'Books',   unit: 'file' },
} %}

<div class="stat-grid">
    {% for type, cfg in typeConfig %}
        {% set info = counts[type] ?? null %}
        <a href="/library/{{ type }}" class="stat-card" data-type="{{ type }}">
            <div class="stat-icon">{{ cfg.icon }}</div>
            <div class="stat-label">{{ cfg.label }}</div>
            <div class="stat-count" data-count="{{ type }}">{{ info ? info.count : 0 }}</div>
            <div class="stat-sub">{{ cfg.unit }}{% if info and info.count != 1 %}s{% endif %}</div>
            <div class="tile-progress"><div class="tile-progress-fill"></div></div>
        </a>
    {% endfor %}
</div>

{% if counts is empty %}
<p style="color: var(--muted); margin-top: 1rem;">
    No media indexed yet. Click <strong>Scan Library</strong> in the nav to index your files.
</p>
{% endif %}
{% endblock %}

{% block scripts %}
<script>
    fetch('/scan/status')
        .then(r => r.json())
        .then(d => {
            if (d.scanning) {
                wasScanning = true;
                startPolling();
            }
        });
</script>
{% endblock %}
