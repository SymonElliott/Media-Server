{% extends 'layout.html.twig' %}
{% block title %}Scan Logs — MediaServer{% endblock %}

{% block scan_context %}{"type":null,"group":null}{% endblock %}

{% block content %}
<div style="max-width:960px;">

    <div class="browse-header" style="margin-bottom:1.25rem;">
        <div class="browse-header-left">
            <h1 style="margin:0;">Scan Logs</h1>
            <span id="log-badge" class="log-badge {% if scanning %}log-badge--live{% endif %}">
                {% if scanning %}● Live{% else %}Idle{% endif %}
            </span>
        </div>
        <div class="browse-header-right" style="gap:0.5rem;">
            <span id="log-meta" style="font-size:0.8rem;color:var(--muted);">
                {% if finished_at %}Last scan: {{ finished_at|date('M j, Y  H:i') }}{% endif %}
            </span>
            <button class="btn-refresh" onclick="downloadLog()" title="Download log file">⬇ Download</button>
            <button class="btn-refresh" onclick="clearDisplay()" title="Clear display (doesn't delete the file)">Clear</button>
        </div>
    </div>

    <div id="log-terminal">
        <div id="log-lines"></div>
        <div id="log-cursor"></div>
    </div>

    <p id="log-empty" style="color:var(--muted);font-size:0.88rem;margin-top:1rem;display:none;">
        No log yet — run a scan and the output will appear here in real time.
    </p>

</div>
{% endblock %}

{% block scripts %}
<style>
    #log-terminal {
        background: #0d0d0d;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1rem 1.25rem;
        font-family: ui-monospace, 'SFMono-Regular', Menlo, Monaco, Consolas, monospace;
        font-size: 0.8rem;
        line-height: 1.65;
        min-height: 420px;
        max-height: 72vh;
        overflow-y: auto;
        color: #c9d1d9;
        position: relative;
        scroll-behavior: smooth;
    }
    .log-line { white-space: pre-wrap; word-break: break-all; }
    .log-line--phase  { color: #58a6ff; font-weight: 600; }
    .log-line--ok     { color: #3fb950; }
    .log-line--fail   { color: #f0883e; }
    .log-line--error  { color: #f85149; }
    .log-line--muted  { color: #6e7681; }
    #log-cursor {
        display: inline-block;
        width: 7px; height: 14px;
        background: var(--accent);
        opacity: 0.75;
        vertical-align: middle;
        animation: blink 1s step-end infinite;
        margin-left: 2px;
    }
    #log-cursor.hidden { display: none; }
    @keyframes blink { 0%,100%{opacity:.75} 50%{opacity:0} }

    .log-badge {
        display: inline-flex; align-items: center;
        padding: 0.2rem 0.65rem; border-radius: 20px;
        font-size: 0.75rem; font-weight: 600;
        background: var(--surface2); color: var(--muted);
        border: 1px solid var(--border);
    }
    .log-badge--live {
        color: #3fb950; border-color: rgba(63,185,80,0.4);
        background: rgba(63,185,80,0.08);
    }
</style>
<script>
    let logOffset   = 0;
    let logTimer    = null;
    let autoScroll  = true;
    let allLogText  = '';

    const terminal = document.getElementById('log-terminal');
    const lines    = document.getElementById('log-lines');
    const cursor   = document.getElementById('log-cursor');
    const badge    = document.getElementById('log-badge');
    const meta     = document.getElementById('log-meta');
    const empty    = document.getElementById('log-empty');

    // Pause auto-scroll when user scrolls up
    terminal.addEventListener('scroll', () => {
        const atBottom = terminal.scrollTop + terminal.clientHeight >= terminal.scrollHeight - 30;
        autoScroll = atBottom;
    });

    function lineClass(text) {
        if (/──/.test(text) || /Phase \d/.test(text) || /Scan (started|complete)/.test(text)) return 'log-line--phase';
        if (/✓/.test(text)) return 'log-line--ok';
        if (/✗ no match/.test(text)) return 'log-line--fail';
        if (/ERROR/.test(text)) return 'log-line--error';
        if (/^$/.test(text.trim())) return 'log-line--muted';
        return '';
    }

    function appendText(text) {
        if (!text) return;
        allLogText += text;
        const newLines = text.split('\n');
        newLines.forEach((line, i) => {
            // Last element may be an incomplete line — skip empty trailing entry
            if (i === newLines.length - 1 && line === '') return;
            const div = document.createElement('div');
            div.className = 'log-line ' + lineClass(line);
            div.textContent = line;
            lines.appendChild(div);
        });
        if (autoScroll) terminal.scrollTop = terminal.scrollHeight;
    }

    function setLive(scanning) {
        cursor.classList.toggle('hidden', !scanning);
        if (scanning) {
            badge.textContent = '● Live';
            badge.className   = 'log-badge log-badge--live';
        } else {
            badge.textContent = 'Idle';
            badge.className   = 'log-badge';
        }
    }

    function pollLog() {
        clearTimeout(logTimer);
        fetch('/scan/log?offset=' + logOffset)
            .then(r => r.json())
            .then(d => {
                if (d.text) {
                    empty.style.display = 'none';
                    appendText(d.text);
                }
                logOffset = d.size;

                setLive(d.scanning);

                if (d.finished_at && !d.scanning) {
                    const dt = new Date(d.finished_at);
                    meta.textContent = 'Last scan: ' + dt.toLocaleDateString('en', {month:'short',day:'numeric',year:'numeric'})
                        + '  ' + dt.toLocaleTimeString('en', {hour:'2-digit',minute:'2-digit'});
                }

                if (logOffset === 0 && !d.scanning) {
                    empty.style.display = 'block';
                }

                logTimer = setTimeout(pollLog, d.scanning ? 800 : 6000);
            })
            .catch(() => { logTimer = setTimeout(pollLog, 3000); });
    }

    function downloadLog() {
        if (!allLogText) return;
        const blob = new Blob([allLogText], { type: 'text/plain' });
        const a    = document.createElement('a');
        a.href     = URL.createObjectURL(blob);
        a.download = 'scan-' + new Date().toISOString().slice(0,10) + '.log';
        a.click();
    }

    function clearDisplay() {
        lines.innerHTML = '';
        allLogText      = '';
        empty.style.display = logOffset === 0 ? 'block' : 'none';
    }

    // Kick off — first call loads the full file (offset 0)
    setLive({{ scanning ? 'true' : 'false' }});
    pollLog();
</script>
{% endblock %}
