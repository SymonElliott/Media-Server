{% extends 'layout.html.twig' %}

{% block scan_context %}{"type":"books","group":{{ author|json_encode }}}{% endblock %}

{#
  Books hierarchy detail page — used for three levels:
    level = 'author'  →  /library/books/Author
    level = 'series'  →  /library/books/Author/Series
    level = 'book'    →  /library/books/Author/[Series/]Book  (version list)
#}

{% block title %}
    {% if level == 'author' %}{{ author }}
    {% elseif level == 'series' %}{{ series }}
    {% else %}{{ book }}
    {% endif %} — MediaServer
{% endblock %}

{% block content %}

{# ── Breadcrumb ─────────────────────────────────────────────────────────── #}
<div class="breadcrumb">
    <a href="/">Home</a>
    <span class="sep">/</span>
    <a href="/library/books">Books</a>
    {% if level != 'author' %}
        <span class="sep">/</span>
        <a href="/library/books/{{ author|url_encode }}">{{ author }}</a>
    {% endif %}
    {% if level == 'book' and series %}
        <span class="sep">/</span>
        <a href="/library/books/{{ author|url_encode }}/{{ series|url_encode }}">{{ series }}</a>
    {% endif %}
    <span class="sep">/</span>
    <span>
        {% if level == 'author' %}{{ author }}
        {% elseif level == 'series' %}{{ series }}
        {% else %}{{ book }}
        {% endif %}
    </span>
</div>

{# ── Pre-compute format sets for book level (needed in hero + list) ─────── #}
{% if level == 'book' %}
    {% set audioEntries = entries|filter(e => e.version_type is defined and e.version_type == 'audio') %}
    {% set ebookEntries = entries|filter(e => e.version_type is defined and e.version_type == 'ebook') %}
{% endif %}

{# ── Hero ───────────────────────────────────────────────────────────────── #}
{% set personImage = (person is defined and person and person.image) ? person.image : null %}
{% set heroPoster = level == 'author'
    ? (personImage ?? entity.poster ?? null)
    : (entity.poster ?? entity.author_image ?? null) %}
<div class="item-hero"{% if heroPoster %} style="--hero-poster: url('{{ heroPoster }}')"{% endif %}>
    <div class="item-hero-bg"></div>
    <div class="item-hero-overlay"></div>
    <div class="item-hero-content">

        {% if heroPoster %}
        <div class="item-hero-poster">
            <img src="{{ heroPoster }}" alt="">
        </div>
        {% endif %}

        <div class="item-hero-info">
            {% if level == 'author' %}
                <div class="item-hero-eyebrow">Author</div>
                <h1>{{ author }}</h1>
            {% elseif level == 'series' %}
                <div class="item-hero-eyebrow">{{ author }}</div>
                <h1>{{ series }}</h1>
                {% if entity.description %}
                    <div class="item-hero-sub" style="max-width:60ch;">{{ entity.description }}</div>
                {% endif %}
            {% else %}
                <div class="item-hero-eyebrow">
                    {{ author }}{% if series %} · {{ series }}{% endif %}
                </div>
                <h1>{{ book }}</h1>
                {% if entity %}
                    <div class="item-hero-sub">
                        {% set parts = [] %}
                        {% if entity.year %}{% set parts = parts|merge([entity.year ~ '']) %}{% endif %}
                        {% if entity.series %}{% set parts = parts|merge([entity.series]) %}{% endif %}
                        {{ parts|join(' · ') }}
                    </div>
                {% endif %}
            {% endif %}

            {% if level == 'author' and person is defined and person and person.slug %}
            <div class="item-hero-actions">
                <a href="/people/{{ person.slug }}" class="btn-refresh" style="text-decoration:none;">View on People</a>
            </div>
            {% elseif level == 'book' %}
            <div class="item-hero-actions">
                {% if ebookEntries is defined and ebookEntries|length > 0 %}
                <a id="btn-read" href="#" target="_blank" rel="noopener" class="btn-play-hero" style="display:none">Read</a>
                {% endif %}
                {% if audioEntries is defined and audioEntries|length > 0 %}
                <a id="btn-listen" href="#" target="_blank" rel="noopener" class="btn-play-hero" style="display:none">&#9654; Listen</a>
                {% endif %}
                {% if entity %}
                <button class="btn-refresh"
                    data-id="{{ entity.id }}"
                    data-type="books"
                    data-label="{{ book|e }}"
                    onclick="openItemMenu(event,this)" title="Options">···</button>
                {% endif %}
            </div>
            {% endif %}
        </div>

    </div>
</div>

{# ── Description (author bio or book description) ────────────────────────── #}
{% if level == 'author' and person is defined and person and person.bio %}
<div class="item-detail-body">
    <p class="item-description">{{ person.bio }}</p>
</div>
{% elseif level == 'book' and entity %}
<div class="item-detail-body">
    {% if entity.description %}
        <p class="item-description">{{ entity.description }}</p>
    {% elseif not entity.metadata_fetched_at %}
        <p class="item-description" style="font-style:italic;">
            No metadata yet — run a scan or refresh to fetch it.
        </p>
    {% endif %}
</div>
{% endif %}

{# ── Entry list ─────────────────────────────────────────────────────────── #}
{% if level == 'book' %}

    {% if ebookEntries|length > 0 %}
    <h2 style="margin: 2rem 0 1rem; font-size:1rem; text-transform:uppercase; letter-spacing:0.5px; color:var(--muted);">Ebooks</h2>
    <div class="item-list">
        {% for entry in ebookEntries %}
            {% for file in entry.files %}
            <div class="item-row-wrap">
                <button class="item-row fmt-row" style="width:100%;text-align:left;background:none;border:none;cursor:pointer;"
                    data-fmt-type="ebook"
                    data-fmt-id="{{ file.db_id ?? '' }}"
                    data-fmt-label="{{ file.stem|e }}"
                    data-fmt-ext="{{ file.extension }}"
                    data-fmt-url="{{ file.url_path }}"
                    onclick="openFmtDetail(this)">
                    <span class="item-icon">📖</span>
                    <span class="item-name">{{ file.stem }}</span>
                    <span class="fmt-default-badge">Default</span>
                    <span class="item-meta">{{ file.extension|upper }}</span>
                </button>
                <button class="item-menu-btn"
                    data-fmt-type="ebook"
                    data-fmt-id="{{ file.db_id ?? '' }}"
                    data-fmt-label="{{ file.stem|e }}"
                    data-fmt-url="{{ file.url_path }}"
                    onclick="openFmtMenu(event,this)" title="Options">···</button>
            </div>
            {% endfor %}
        {% endfor %}
    </div>
    {% endif %}

    {% if audioEntries|length > 0 %}
    <h2 style="margin: 2rem 0 1rem; font-size:1rem; text-transform:uppercase; letter-spacing:0.5px; color:var(--muted);">Audiobooks</h2>
    <div class="item-list">
        {% for entry in audioEntries %}
        <div class="item-row-wrap">
            <button class="item-row fmt-row" style="width:100%;text-align:left;background:none;border:none;cursor:pointer;"
                data-fmt-type="audio"
                data-fmt-id="{{ entry.first_db_id ?? '' }}"
                data-fmt-label="{{ entry.name|e }}"
                data-fmt-ext="{{ entry.extension ?? 'audio' }}"
                data-fmt-url="{{ entry.url_path }}"
                data-fmt-count="{{ entry.file_count }}"
                data-fmt-is-dir="{{ entry.is_dir ? '1' : '0' }}"
                onclick="openFmtDetail(this)">
                <span class="item-icon">&#9654;</span>
                <span class="item-name">{{ entry.name }}</span>
                <span class="fmt-default-badge">Default</span>
                <span class="item-meta">
                    {%- if entry.is_dir -%}
                        {{ entry.file_count }} chapter{{ entry.file_count != 1 ? 's' : '' }}
                    {%- else -%}
                        {{ (entry.extension ?? 'audio')|upper }}
                    {%- endif -%}
                </span>
            </button>
            <button class="item-menu-btn"
                data-fmt-type="audio"
                data-fmt-id="{{ entry.first_db_id ?? '' }}"
                data-fmt-label="{{ entry.name|e }}"
                data-fmt-ext="{{ entry.extension ?? 'audio' }}"
                data-fmt-url="{{ entry.url_path }}"
                data-fmt-count="{{ entry.file_count }}"
                data-fmt-is-dir="{{ entry.is_dir ? '1' : '0' }}"
                onclick="openFmtMenu(event,this)" title="Options">···</button>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    {% if ebookEntries|length == 0 and audioEntries|length == 0 %}
    <p style="color:var(--muted);">Nothing found here.</p>
    {% endif %}

    {# ── File detail overlay ──────────────────────────────────────────────── #}
    <style>
        .fmt-overlay-backdrop {
            position: fixed; inset: 0; background: rgba(0,0,0,0.6);
            z-index: 300; display: flex; align-items: center; justify-content: center;
        }
        .fmt-overlay-panel {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: 10px; padding: 1.75rem; width: 100%; max-width: 420px;
            position: relative; box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }
        .fmt-overlay-close {
            position: absolute; top: 0.75rem; right: 0.75rem;
            background: none; border: none; color: var(--muted);
            font-size: 1.3rem; cursor: pointer; line-height: 1;
            padding: 0.2rem 0.4rem; border-radius: 4px;
            transition: color 0.15s;
        }
        .fmt-overlay-close:hover { color: var(--text); }
        .fmt-overlay-icon { font-size: 2rem; margin-bottom: 0.5rem; }
        .fmt-overlay-title { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.25rem; }
        .fmt-overlay-sub { font-size: 0.85rem; color: var(--muted); margin-bottom: 1.25rem; }
        .fmt-overlay-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
        .fmt-overlay-divider { border: none; border-top: 1px solid var(--border); margin: 1rem 0; }
        .fmt-overlay-mgmt { display: flex; flex-wrap: wrap; gap: 0.5rem; }
        .btn-set-default {
            background: none; border: 1px solid var(--border); color: var(--muted);
            padding: 0.35rem 0.85rem; border-radius: 6px; font-size: 0.85rem;
            cursor: pointer; transition: color 0.15s, border-color 0.15s;
        }
        .btn-set-default:hover { color: var(--accent); border-color: var(--accent); }
        .btn-set-default.is-default { color: var(--accent); border-color: var(--accent); }
        .btn-edit-meta {
            background: none; border: 1px solid var(--border); color: var(--muted);
            padding: 0.35rem 0.85rem; border-radius: 6px; font-size: 0.85rem;
            cursor: pointer; transition: color 0.15s, border-color 0.15s;
        }
        .btn-edit-meta:hover { color: var(--text); border-color: var(--muted); }
        .btn-delete-fmt {
            background: none; border: 1px solid var(--border); color: #e05;
            padding: 0.35rem 0.85rem; border-radius: 6px; font-size: 0.85rem;
            cursor: pointer; transition: background 0.15s, border-color 0.15s;
        }
        .btn-delete-fmt:hover { background: rgba(238,0,85,0.1); border-color: #e05; }
        .fmt-default-badge {
            display: none;
            font-size: 0.7rem; font-weight: 500;
            color: var(--accent); border: 1px solid var(--accent);
            border-radius: 10px; padding: 0.1rem 0.5rem;
            line-height: 1.5; white-space: nowrap;
            margin-right: 0.4rem; flex-shrink: 0;
        }
    </style>

    <div id="fmt-overlay" style="display:none;" onclick="if(event.target===this)closeFmtDetail()">
        <div class="fmt-overlay-backdrop" onclick="closeFmtDetail()">
            <div class="fmt-overlay-panel" onclick="event.stopPropagation()">
                <button class="fmt-overlay-close" onclick="closeFmtDetail()">×</button>
                <div class="fmt-overlay-icon" id="fo-icon"></div>
                <div class="fmt-overlay-title" id="fo-title"></div>
                <div class="fmt-overlay-sub" id="fo-sub"></div>
                <div class="fmt-overlay-actions" id="fo-actions"></div>
                <hr class="fmt-overlay-divider">
                <div class="fmt-overlay-mgmt" id="fo-mgmt"></div>
            </div>
        </div>
    </div>

    <script>
    (function () {
        const BOOK_KEY  = {{ urlPath|json_encode|raw }};
        const defKey    = t => 'bdef-' + t + ':' + BOOK_KEY;
        const getDefUrl = t => localStorage.getItem(defKey(t));
        const setDefUrl = (t, url) => { localStorage.setItem(defKey(t), url); };

        // ── Init CTA buttons ─────────────────────────────────────────────────
        function refreshCTAs() {
            const rows = document.querySelectorAll('.fmt-row');

            // Determine best ebook / audio url
            let ebookUrl = getDefUrl('ebook');
            let audioUrl = getDefUrl('audio');

            if (!ebookUrl) {
                const r = document.querySelector('.fmt-row[data-fmt-type="ebook"]');
                ebookUrl = r ? r.dataset.fmtUrl : null;
            }
            if (!audioUrl) {
                const r = document.querySelector('.fmt-row[data-fmt-type="audio"]');
                audioUrl = r ? r.dataset.fmtUrl : null;
            }

            const btnRead   = document.getElementById('btn-read');
            const btnListen = document.getElementById('btn-listen');
            if (btnRead && ebookUrl) {
                btnRead.href         = '/read/books/' + ebookUrl;
                btnRead.style.display = '';
            }
            if (btnListen && audioUrl) {
                btnListen.href         = '/library/books/' + audioUrl;
                btnListen.style.display = '';
            }
        }

        // ── Default badges ───────────────────────────────────────────────────
        function refreshBadges() {
            const ebookDef = getDefUrl('ebook');
            const audioDef = getDefUrl('audio');
            document.querySelectorAll('.fmt-row').forEach(row => {
                const badge = row.querySelector('.fmt-default-badge');
                if (!badge) return;
                const t   = row.dataset.fmtType;
                const def = t === 'ebook' ? ebookDef : audioDef;
                badge.style.display = (def && row.dataset.fmtUrl === def) ? '' : 'none';
            });
        }

        // ── Set default ──────────────────────────────────────────────────────
        window.setFmtDefault = function (type, url, label) {
            setDefUrl(type, url);
            refreshCTAs();
            refreshBadges();
            // Update overlay button state if open
            const btn = document.getElementById('fo-set-default');
            if (btn) { btn.classList.add('is-default'); btn.textContent = '★ Default'; }
            showToast('Default ' + (type === 'ebook' ? 'ebook' : 'audiobook') + ' set');
        };

        // ── Open overlay ─────────────────────────────────────────────────────
        window.openFmtDetail = function (row) {
            const type  = row.dataset.fmtType;
            const id    = row.dataset.fmtId   || null;
            const label = row.dataset.fmtLabel || '';
            const ext   = row.dataset.fmtExt  || '';
            const url   = row.dataset.fmtUrl  || '';
            const count = row.dataset.fmtCount || null;

            document.getElementById('fo-icon').textContent  = type === 'audio' ? '▶' : '📖';
            document.getElementById('fo-title').textContent = label;

            const isDir = row.dataset.fmtIsDir === '1';
            const sub = type === 'audio'
                ? (isDir && count ? count + ' chapter' + (count != 1 ? 's' : '') : ext.toUpperCase())
                : ext.toUpperCase();
            document.getElementById('fo-sub').textContent = sub;

            // Primary actions
            let actHtml = '';
            if (type === 'ebook') {
                actHtml += `<a href="/read/books/${url}" target="_blank" rel="noopener" class="btn-play-hero">Read ${ext.toUpperCase()}</a>`;
                actHtml += `<a href="/stream/books/${url}" class="btn-refresh" download style="text-decoration:none;">Download</a>`;
            } else {
                actHtml += `<a href="/library/books/${url}" target="_blank" rel="noopener" class="btn-play-hero">&#9654; Listen</a>`;
            }
            document.getElementById('fo-actions').innerHTML = actHtml;

            // Management actions
            const isDefault = getDefUrl(type) === url;
            let mgmtHtml = `<button id="fo-set-default" class="btn-set-default${isDefault ? ' is-default' : ''}"
                onclick="setFmtDefault('${type}','${url.replace(/'/g,"\\'")}','${label.replace(/'/g,"\\'")}')">
                ${isDefault ? '★ Default' : 'Set as Default'}
            </button>`;
            if (id) {
                mgmtHtml += `<button class="btn-edit-meta"
                    onclick="openEditModal('${id}','books','${label.replace(/'/g,"\\'")}')">Edit Metadata</button>`;
                mgmtHtml += `<button class="btn-delete-fmt"
                    onclick="handleDelete('${id}','books',null,null,'${label.replace(/'/g,"\\'")}');closeFmtDetail()">Delete</button>`;
            }
            document.getElementById('fo-mgmt').innerHTML = mgmtHtml;

            document.getElementById('fmt-overlay').style.display = '';
            document.addEventListener('keydown', fmtEscHandler);
        };

        window.closeFmtDetail = function () {
            document.getElementById('fmt-overlay').style.display = 'none';
            document.removeEventListener('keydown', fmtEscHandler);
        };

        function fmtEscHandler(e) {
            if (e.key === 'Escape') closeFmtDetail();
        }

        // ── Ellipsis menu (reuses layout dropdown) ───────────────────────────
        window.openFmtMenu = function (event, btn) {
            event.preventDefault();
            event.stopPropagation();

            const type  = btn.dataset.fmtType;
            const id    = btn.dataset.fmtId   || null;
            const label = btn.dataset.fmtLabel || '';
            const url   = btn.dataset.fmtUrl  || '';
            const count = btn.dataset.fmtCount || null;

            // Reuse the global singleton dropdown from layout
            const dd = document.getElementById('item-dropdown');
            if (!dd) return;

            // Close any open dropdown first (layout's closeDropdown)
            if (typeof closeDropdown === 'function') closeDropdown();

            dd.innerHTML = '';

            const mkBtn = (text, cls, cb) => {
                const b = document.createElement('button');
                b.textContent = text;
                if (cls) b.className = cls;
                b.onclick = cb;
                dd.appendChild(b);
            };

            mkBtn('Details', '', () => { closeDropdown(); openFmtDetail(btn); });

            const isDefault = getDefUrl(type) === url;
            mkBtn(isDefault ? '★ Default' : 'Set as Default', isDefault ? 'dd-active' : '', () => {
                closeDropdown();
                setFmtDefault(type, url, label);
            });

            if (id) {
                mkBtn('Edit Metadata', '', () => { closeDropdown(); openEditModal(id, 'books', label); });
                mkBtn('Delete', 'dd-danger', () => { closeDropdown(); handleDelete(id, 'books', null, null, label); });
            }

            const rect = btn.getBoundingClientRect();
            dd.style.display = 'block';
            dd.style.top     = (rect.bottom + 4) + 'px';
            dd.style.left    = Math.max(4, rect.right - 160) + 'px';

            // Track active trigger so layout's global click-away handler works
            if (typeof activeTrigger !== 'undefined') {
                btn.classList.add('active');
                // eslint-disable-next-line no-global-assign
                activeTrigger = btn;
            }
        };

        // ── Boot ─────────────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            // Auto-set default when only one option exists for a type
            ['ebook', 'audio'].forEach(function (type) {
                if (getDefUrl(type)) return; // already stored
                const rows = document.querySelectorAll('.fmt-row[data-fmt-type="' + type + '"]');
                if (rows.length === 1) setDefUrl(type, rows[0].dataset.fmtUrl);
            });
            refreshCTAs();
            refreshBadges();
        });
    })();
    </script>

{% else %}
{% if level == 'author' %}
<h2 style="margin: 2rem 0 1rem; font-size:1rem; text-transform:uppercase; letter-spacing:0.5px; color:var(--muted);">Library</h2>
{% endif %}

<div class="item-list">
    {% for entry in entries %}
        {% if not entry.is_dir %}
            {# Unexpected file at this level — skip #}
        {% elseif entry.item_type is defined and entry.item_type == 'series' %}
            {# Series entry on author page — expandable #}
            <div class="item-expandable">
            <div class="item-row-wrap">
                <div class="item-row item-row--expandable"
                     data-expand-path="{{ entry.url_path }}"
                     data-expand-type="books"
                     onclick="toggleExpand(this)"
                     role="button" tabindex="0">
                    {% if entry.poster %}
                        <img src="{{ entry.poster }}" class="item-thumb" alt="">
                    {% else %}
                        <span class="item-icon">📚</span>
                    {% endif %}
                    <span class="item-name">{{ entry.name }}</span>
                    <span class="item-meta">
                        {% if entry.book_count is defined %}
                            {{ entry.book_count }} book{{ entry.book_count != 1 ? 's' : '' }}
                        {% endif %}
                    </span>
                    <span class="expand-chevron">›</span>
                </div>
                <button class="item-menu-btn"
                    data-type="books"
                    data-group="{{ entry.name }}"
                    data-col="series"
                    data-label="{{ entry.name }}"
                    onclick="openItemMenu(event,this)" title="Options">···</button>
            </div>
            <div class="item-expand-panel"></div>
            </div>
        {% else %}
            {# Book entry (on author or series page) #}
            <div class="item-row-wrap">
                <a href="/library/books/{{ entry.url_path }}" class="item-row" data-group-name="{{ entry.name }}">
                    {% if entry.poster %}
                        <img src="{{ entry.poster }}" class="item-thumb" alt="">
                    {% else %}
                        <span class="item-icon">📖</span>
                    {% endif %}
                    <span class="item-name">{{ entry.name }}</span>
                    <span class="item-meta">
                        {%- if entry.series_order is defined and entry.series_order -%}
                            #{{ entry.series_order % 1 == 0 ? entry.series_order|number_format(0) : entry.series_order|number_format(1) }}
                        {%- elseif entry.year is defined and entry.year -%}
                            {{ entry.year }}
                        {%- elseif entry.version_count is defined -%}
                            {{ entry.version_count }} format{{ entry.version_count != 1 ? 's' : '' }}
                        {%- endif -%}
                    </span>
                </a>
                <button class="item-menu-btn"
                    data-type="books"
                    data-group="{{ entry.name }}"
                    data-label="{{ entry.name }}"
                    onclick="openItemMenu(event,this)" title="Options">···</button>
            </div>
        {% endif %}
    {% else %}
        <p style="color:var(--muted);">Nothing found here.</p>
    {% endfor %}

    {# Standalone book (same name as series) appended directly to the list #}
    {% if level == 'series' and standalone_book is defined and standalone_book %}
    <div class="item-row-wrap">
        <a href="/library/books/{{ author|url_encode }}/{{ series|url_encode }}" class="item-row">
            {% if standalone_book.poster %}
                <img src="{{ standalone_book.poster }}" class="item-thumb" alt="">
            {% else %}
                <span class="item-icon">📖</span>
            {% endif %}
            <span class="item-name">{{ series }}</span>
            <span class="item-meta">{{ standalone_book.year ?? '' }}</span>
        </a>
        <button class="item-menu-btn"
            data-type="books"
            data-group="{{ series }}"
            data-label="{{ series }}"
            onclick="openItemMenu(event,this)" title="Options">···</button>
    </div>
    {% endif %}
</div>
{% endif %}{# end level != 'book' branch #}

{% endblock %}
