{% extends 'layout.html.twig' %}

{% set typeLabel = {
    movies: 'Movies', shows: 'Shows', music: 'Music',
    audiobooks: 'Audiobooks', books: 'Books'
} %}
{% set typeIcon = {
    movies: '🎬', shows: '📺', music: '🎵', audiobooks: '🎧', books: '📚'
} %}

{% block title %}{{ path }} — MediaServer{% endblock %}

{% block content %}
{% set parts = path|split('/') %}
<div class="breadcrumb">
    <a href="/">Home</a>
    <span class="sep">/</span>
    <a href="/library/{{ type }}">{{ typeLabel[type] }}</a>
    {% set accum = '' %}
    {% for part in parts %}
        {% set accum = accum ~ (loop.first ? '' : '/') ~ part %}
        <span class="sep">/</span>
        {% if not loop.last %}
            <a href="/library/{{ type }}/{{ accum }}">{{ part }}</a>
        {% else %}
            <span>{{ part }}</span>
        {% endif %}
    {% endfor %}
</div>

<h1>{{ parts|last }}</h1>

<div class="item-list">
    {% for entry in entries %}
        {% if not entry.is_dir and entry.id is defined and entry.id %}
            <div class="item-row-wrap">
                <a href="/library/{{ type }}/{{ entry.url_path }}" class="item-row" data-media-id="{{ entry.id }}">
                    {% if entry.poster %}
                        <img src="{{ entry.poster }}" class="item-thumb" alt="">
                    {% else %}
                        <span class="item-icon">{{ typeIcon[type] }}</span>
                    {% endif %}
                    <span class="item-name">{{ entry.title ?? entry.name }}</span>
                    <span class="item-meta">
                        {% if entry.season is defined and entry.season %}
                            S{{ '%02d'|format(entry.season) }}{% if entry.episode %}E{{ '%02d'|format(entry.episode) }}{% endif %}
                        {% endif %}
                    </span>
                </a>
                <button class="item-menu-btn" data-id="{{ entry.id }}" data-type="{{ type }}" data-label="{{ (entry.title ?? entry.name)|e }}" onclick="openItemMenu(event,this)" title="Options">···</button>
            </div>
        {% else %}
            <a href="/library/{{ type }}/{{ entry.url_path }}" class="item-row">
                {% if entry.poster %}
                    <img src="{{ entry.poster }}" class="item-thumb" alt="">
                {% elseif entry.is_dir %}
                    <span class="item-icon">📁</span>
                {% else %}
                    <span class="item-icon">{{ typeIcon[type] }}</span>
                {% endif %}
                <span class="item-name">{{ entry.title ?? entry.name }}</span>
                <span class="item-meta">
                    {% if entry.is_dir %}
                        folder
                    {% elseif entry.season is defined and entry.season %}
                        S{{ '%02d'|format(entry.season) }}{% if entry.episode %}E{{ '%02d'|format(entry.episode) }}{% endif %}
                    {% endif %}
                </span>
            </a>
        {% endif %}
    {% else %}
        <p style="color: var(--muted);">Empty directory.</p>
    {% endfor %}
</div>
{% endblock %}
