{% extends 'layout.html.twig' %}

{% set typeLabel = {
    movies: 'Movies', shows: 'Shows', music: 'Music', books: 'Books'
} %}

{% set typeIcon = {
    movies: '🎬', shows: '📺', music: '🎵', books: '📚'
} %}

{% block title %}{{ typeLabel[type] }} — MediaServer{% endblock %}

{% block content %}
<div class="breadcrumb">
    <a href="/">Home</a>
    <span class="sep">/</span>
    <span>{{ typeLabel[type] }}</span>
</div>

{% set tabs = {
    music: { artists: 'Artists', albums: 'Albums', songs: 'Songs' },
    books: { authors: 'Authors', series: 'Series', books: 'Books' }
} %}
{% set currentView = view ?? (type == 'music' ? 'artists' : (type == 'books' ? 'authors' : null)) %}
{% set menuCol = (type == 'music' and currentView == 'albums') ? 'series'
              : ((type == 'books' and currentView == 'series') ? 'series' : null) %}

<div style="display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:1.5rem;">
    <div style="display:flex; align-items:center; gap:1rem;">
        <h1 style="margin-bottom:0;">{{ typeIcon[type] }} {{ typeLabel[type] }}</h1>
        {% if tabs[type] is defined %}
        <div class="browse-tabs">
            {% for tabKey, tabLabel in tabs[type] %}
                <a href="/library/{{ type }}?view={{ tabKey }}"
                   class="browse-tab{% if currentView == tabKey %} active{% endif %}">{{ tabLabel }}</a>
            {% endfor %}
        </div>
        {% endif %}
    </div>
    <div style="display:flex; gap:0.5rem; align-items:center;">
        <button class="btn-view-toggle" id="btn-grid" onclick="setView('grid')" title="Grid view">⊞</button>
        <button class="btn-view-toggle" id="btn-list" onclick="setView('list')" title="List view">☰</button>
        <form method="post" action="/metadata/refresh-type/{{ type }}">
            <button type="submit" class="btn-refresh">↻ Refresh Metadata</button>
        </form>
    </div>
</div>

{% if grouped %}
    {# ── List view ── #}
    <div id="view-list" class="item-list">
        {% for item in items %}
            {% set name      = item.name ?? item.show_name ?? item.author ?? '(Unknown)' %}
            {% set count     = item.file_count ?? item.episode_count ?? item.track_count ?? item.item_count ?? 0 %}
            {% set thumb     = item.poster ?? null %}
            {% set href      = item.url_path is defined
                ? '/library/' ~ type ~ '/' ~ item.url_path
                : '/library/' ~ type ~ '/' ~ (name|url_encode) %}
            {% if type == 'shows' %}
                {% set metaLabel = count ~ ' episode' ~ (count != 1 ? 's' : '') %}
            {% elseif type == 'music' %}
                {% set metaLabel = count ~ ' track' ~ (count != 1 ? 's' : '') %}
            {% elseif type == 'books' %}
                {% set metaLabel = count ~ ' book' ~ (count != 1 ? 's' : '') %}
            {% else %}
                {% set metaLabel = count ~ ' item' ~ (count != 1 ? 's' : '') %}
            {% endif %}
            {% set needsMeta = item.pending_meta is defined and item.pending_meta > 0 %}
            <div class="item-row-wrap">
                <a href="{{ href }}" class="item-row{% if needsMeta %} meta-pending{% endif %}" data-group-name="{{ name }}">
                    {% if thumb %}
                        <img src="{{ thumb }}" class="item-thumb{% if type == 'music' %} item-thumb--square{% endif %}" alt="">
                    {% else %}
                        <span class="item-icon">{{ typeIcon[type] }}</span>
                    {% endif %}
                    <span class="item-name">{{ name }}</span>
                    <span class="item-meta">{{ metaLabel }}</span>
                </a>
                <button class="item-menu-btn"
                    data-type="{{ type }}"
                    data-group="{{ name }}"
                    {% if menuCol %}data-col="{{ menuCol }}"{% endif %}
                    data-label="{{ name }}"
                    onclick="openItemMenu(event,this)" title="Options">···</button>
            </div>
        {% else %}
            <p style="color: var(--muted);">No {{ typeLabel[type]|lower }} found. Run a scan to index your library.</p>
        {% endfor %}
    </div>

    {# ── Grid view ── #}
    <div id="view-grid" class="grid" style="display:none;">
        {% for item in items %}
            {% set name  = item.name ?? item.show_name ?? item.author ?? '(Unknown)' %}
            {% set count = item.file_count ?? item.episode_count ?? item.track_count ?? item.item_count ?? 0 %}
            {% set thumb = item.poster ?? null %}
            {% set href  = item.url_path is defined
                ? '/library/' ~ type ~ '/' ~ item.url_path
                : '/library/' ~ type ~ '/' ~ (name|url_encode) %}
            {% if type == 'shows' %}
                {% set metaLabel = count ~ ' episode' ~ (count != 1 ? 's' : '') %}
            {% elseif type == 'music' %}
                {% set metaLabel = count ~ ' track' ~ (count != 1 ? 's' : '') %}
            {% elseif type == 'books' %}
                {% set metaLabel = count ~ ' book' ~ (count != 1 ? 's' : '') %}
            {% else %}
                {% set metaLabel = count ~ ' item' ~ (count != 1 ? 's' : '') %}
            {% endif %}
            {% set needsMeta = item.pending_meta is defined and item.pending_meta > 0 %}
            {% set squarePoster = type == 'music' %}
            <a href="{{ href }}" class="card{% if needsMeta %} meta-pending{% endif %}" data-group-name="{{ name }}">
                {% if thumb %}
                    <img src="{{ thumb }}" class="card-poster{% if squarePoster %} card-poster--square{% endif %}" alt="">
                {% else %}
                    <div class="card-poster-empty{% if squarePoster %} card-poster-empty--square{% endif %}">{{ typeIcon[type] }}</div>
                {% endif %}
                <div class="card-title">{{ name }}</div>
                <div class="card-meta">{{ metaLabel }}</div>
            </a>
        {% else %}
            <p style="color: var(--muted);">No {{ typeLabel[type]|lower }} found.</p>
        {% endfor %}
    </div>

{% elseif currentView == 'songs' %}
    {# ── Songs flat list ── #}
    <div id="view-list" class="item-list">
        {% for item in items %}
            <div class="item-row-wrap">
                <a href="/library/music/{{ item.relative_path }}" class="item-row{% if not item.metadata_fetched_at %} meta-pending{% endif %}" data-media-id="{{ item.id }}"{% if item.author %} data-group-name="{{ item.author }}"{% endif %}>
                    {% if item.poster %}
                        <img src="{{ item.poster }}" class="item-thumb item-thumb--square" alt="">
                    {% else %}
                        <span class="item-icon">🎵</span>
                    {% endif %}
                    <span class="item-name">{{ item.title ?? item.relative_path }}</span>
                    <span class="item-meta">
                        {% set parts = [] %}
                        {% if item.author %}{% set parts = parts|merge([item.author]) %}{% endif %}
                        {% if item.album %}{% set parts = parts|merge([item.album]) %}{% endif %}
                        {% if item.year %}{% set parts = parts|merge([item.year ~ '']) %}{% endif %}
                        {% if item.duration %}
                            {% set dm = (item.duration / 60)|round(0, 'floor') %}
                            {% set ds = item.duration % 60 %}
                            {% set parts = parts|merge([dm ~ ':' ~ (ds < 10 ? '0' : '') ~ ds]) %}
                        {% endif %}
                        {{ parts|join(' · ') }}
                    </span>
                </a>
                <button class="item-menu-btn" data-id="{{ item.id }}" data-type="music" data-label="{{ (item.title ?? '')|e }}" onclick="openItemMenu(event,this)" title="Options">···</button>
            </div>
        {% else %}
            <p style="color: var(--muted);">No songs found. Run a scan to index your library.</p>
        {% endfor %}
    </div>

    <div id="view-grid" class="grid" style="display:none;">
        {% for item in items %}
            <a href="/library/music/{{ item.relative_path }}" class="card" data-media-id="{{ item.id }}"{% if item.author %} data-group-name="{{ item.author }}"{% endif %}>
                {% if item.poster %}
                    <img src="{{ item.poster }}" class="card-poster card-poster--square" alt="">
                {% else %}
                    <div class="card-poster-empty card-poster-empty--square">🎵</div>
                {% endif %}
                <div class="card-title">{{ item.title ?? item.relative_path }}</div>
                <div class="card-meta">{{ item.author ?? '' }}{% if item.album %} · {{ item.album }}{% endif %}</div>
            </a>
        {% else %}
            <p style="color: var(--muted);">No songs found.</p>
        {% endfor %}
    </div>

{% elseif currentView == 'books' %}
    {# ── Books flat list (all books across all authors) ── #}
    <div id="view-list" class="item-list">
        {% for item in items %}
            <div class="item-row-wrap">
                <a href="/library/books/{{ item.url_path }}" class="item-row" data-group-name="{{ item.series ?? item.name }}">
                    {% if item.poster %}
                        <img src="{{ item.poster }}" class="item-thumb" alt="">
                    {% else %}
                        <span class="item-icon">📚</span>
                    {% endif %}
                    <span class="item-name">{{ item.name }}</span>
                    <span class="item-meta">
                        {% set parts = [] %}
                        {% if item.author %}{% set parts = parts|merge([item.author]) %}{% endif %}
                        {% if item.series %}{% set parts = parts|merge([item.series]) %}{% endif %}
                        {% if item.year %}{% set parts = parts|merge([item.year ~ '']) %}{% endif %}
                        {% if item.has_audio and item.has_ebook %}{% set parts = parts|merge(['📖+🎧']) %}
                        {% elseif item.has_audio %}{% set parts = parts|merge(['🎧']) %}
                        {% elseif item.has_ebook %}{% set parts = parts|merge(['📖']) %}{% endif %}
                        {{ parts|join(' · ') }}
                    </span>
                </a>
                <button class="item-menu-btn" data-type="books" data-group="{{ item.name }}" data-label="{{ item.name|e }}" onclick="openItemMenu(event,this)" title="Options">···</button>
            </div>
        {% else %}
            <p style="color: var(--muted);">No books found. Run a scan to index your library.</p>
        {% endfor %}
    </div>

    <div id="view-grid" class="grid" style="display:none;">
        {% for item in items %}
            <a href="/library/books/{{ item.url_path }}" class="card" data-group-name="{{ item.series ?? item.name }}">
                {% if item.poster %}
                    <img src="{{ item.poster }}" class="card-poster" alt="">
                {% else %}
                    <div class="card-poster-empty">📚</div>
                {% endif %}
                <div class="card-title">{{ item.name }}</div>
                <div class="card-meta">{{ item.author ?? '' }}{% if item.year %} · {{ item.year }}{% endif %}</div>
            </a>
        {% else %}
            <p style="color: var(--muted);">No books found.</p>
        {% endfor %}
    </div>

{% else %}
    {# ── List view (flat: movies) ── #}
    <div id="view-list" class="item-list">
        {% for item in items %}
            <div class="item-row-wrap">
                <a href="/library/{{ type }}/{{ item.relative_path }}" class="item-row{% if not item.metadata_fetched_at %} meta-pending{% endif %}" data-media-id="{{ item.id }}">
                    {% if item.poster %}
                        <img src="{{ item.poster }}" class="item-thumb" alt="">
                    {% else %}
                        <span class="item-icon">{{ typeIcon[type] }}</span>
                    {% endif %}
                    <span class="item-name">{{ item.title ?? item.filename }}</span>
                    <span class="item-meta">
                        {% set parts = [] %}
                        {% if item.author %}{% set parts = parts|merge([item.author]) %}{% endif %}
                        {% if item.series and item.series != (item.title ?? item.filename) %}
                            {% set parts = parts|merge([item.series]) %}
                        {% endif %}
                        {% if item.year %}{% set parts = parts|merge([item.year ~ '']) %}{% endif %}
                        {{ parts|join(' · ') }}
                    </span>
                </a>
                <button class="item-menu-btn" data-id="{{ item.id }}" data-type="{{ type }}" data-label="{{ (item.title ?? item.filename)|e }}" onclick="openItemMenu(event,this)" title="Options">···</button>
            </div>
        {% else %}
            <p style="color: var(--muted);">No {{ typeLabel[type]|lower }} found. Run a scan to index your library.</p>
        {% endfor %}
    </div>

    {# ── Grid view (flat: movies) ── #}
    <div id="view-grid" class="grid" style="display:none;">
        {% for item in items %}
            <a href="/library/{{ type }}/{{ item.relative_path }}" class="card{% if not item.metadata_fetched_at %} meta-pending{% endif %}" data-media-id="{{ item.id }}">
                {% if item.poster %}
                    <img src="{{ item.poster }}" class="card-poster" alt="">
                {% else %}
                    <div class="card-poster-empty">{{ typeIcon[type] }}</div>
                {% endif %}
                <div class="card-title">{{ item.title ?? item.filename }}</div>
                {% if item.year %}<div class="card-meta">{{ item.year }}</div>{% endif %}
            </a>
        {% else %}
            <p style="color: var(--muted);">No {{ typeLabel[type]|lower }} found.</p>
        {% endfor %}
    </div>
{% endif %}

{% block scripts %}
<script>
(function () {
    const KEY  = 'browseView_{{ type }}_{{ currentView ?? "default" }}';
    const list = document.getElementById('view-list');
    const grid = document.getElementById('view-grid');
    const btnGrid = document.getElementById('btn-grid');
    const btnList = document.getElementById('btn-list');

    function applyView(v) {
        const isGrid = v === 'grid';
        list.style.display = isGrid ? 'none' : '';
        grid.style.display = isGrid ? ''     : 'none';
        btnGrid.classList.toggle('active', isGrid);
        btnList.classList.toggle('active', !isGrid);
    }

    window.setView = function (v) {
        localStorage.setItem(KEY, v);
        applyView(v);
    };

    applyView(localStorage.getItem(KEY) || 'list');
})();
</script>
{% endblock %}

{% if pages > 1 %}
{% set viewParam = view ? '&view=' ~ view : '' %}
<div class="pagination">
    {% if page > 1 %}
        <a href="?page={{ page - 1 }}{{ viewParam }}">&larr; Prev</a>
    {% endif %}
    {% for p in 1..pages %}
        {% if p == page %}
            <span class="current">{{ p }}</span>
        {% else %}
            <a href="?page={{ p }}{{ viewParam }}">{{ p }}</a>
        {% endif %}
    {% endfor %}
    {% if page < pages %}
        <a href="?page={{ page + 1 }}{{ viewParam }}">Next &rarr;</a>
    {% endif %}
</div>
{% endif %}
{% endblock %}
