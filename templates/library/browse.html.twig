{% extends 'layout.html.twig' %}

{% set typeLabel = {
    movies: 'Movies', shows: 'Shows', music: 'Music', books: 'Books'
} %}

{% set typeIcon = {
    movies: '🎬', shows: '📺', music: '🎵', books: '📚'
} %}

{% block title %}{{ typeLabel[type] }} — MediaServer{% endblock %}

{% block content %}
<div class="breadcrumb">
    <a href="/">Home</a>
    <span class="sep">/</span>
    <span>{{ typeLabel[type] }}</span>
</div>

<div style="display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:1.5rem;">
    <h1 style="margin-bottom:0;">{{ typeIcon[type] }} {{ typeLabel[type] }}</h1>
    <form method="post" action="/metadata/refresh-type/{{ type }}">
        <button type="submit" class="btn-refresh">↻ Refresh Metadata</button>
    </form>
</div>

{% if grouped %}
    {# Shows grouped by show_name / Music grouped by artist / Books grouped by author #}
    <div class="item-list">
        {% for item in items %}
            {% set name      = item.name ?? item.show_name ?? item.author ?? '(Unknown)' %}
            {% set count     = item.file_count ?? item.episode_count ?? item.track_count ?? item.item_count ?? 0 %}
            {% set thumb     = item.poster ?? null %}
            {% set href      = item.url_path is defined
                ? '/library/' ~ type ~ '/' ~ item.url_path
                : '/library/' ~ type ~ '/' ~ (name|url_encode) %}
            {% if type == 'shows' %}
                {% set metaLabel = count ~ ' episode' ~ (count != 1 ? 's' : '') %}
            {% elseif type == 'music' %}
                {% set metaLabel = count ~ ' track' ~ (count != 1 ? 's' : '') %}
            {% elseif type == 'books' %}
                {% set metaLabel = count ~ ' item' ~ (count != 1 ? 's' : '') %}
            {% else %}
                {% set metaLabel = count ~ ' item' ~ (count != 1 ? 's' : '') %}
            {% endif %}
            {% set needsMeta = item.pending_meta is defined and item.pending_meta > 0 %}
            <div class="item-row-wrap">
                <a href="{{ href }}" class="item-row{% if needsMeta %} meta-pending{% endif %}" data-group-name="{{ name }}">
                    {% if thumb %}
                        <img src="{{ thumb }}" class="item-thumb" alt="">
                    {% else %}
                        <span class="item-icon">{{ typeIcon[type] }}</span>
                    {% endif %}
                    <span class="item-name">{{ name }}</span>
                    <span class="item-meta">{{ metaLabel }}</span>
                </a>
                <button class="item-menu-btn"
                    data-type="{{ type }}"
                    data-group="{{ name }}"
                    data-label="{{ name }}"
                    onclick="openItemMenu(event,this)" title="Options">···</button>
            </div>
        {% else %}
            <p style="color: var(--muted);">No {{ typeLabel[type]|lower }} found. Run a scan to index your library.</p>
        {% endfor %}
    </div>
{% else %}
    {# Flat list: movies, books, audiobooks #}
    <div class="item-list">
        {% for item in items %}
            <div class="item-row-wrap">
                <a href="/library/{{ type }}/{{ item.relative_path }}" class="item-row{% if not item.metadata_fetched_at %} meta-pending{% endif %}" data-media-id="{{ item.id }}">
                    {% if item.poster %}
                        <img src="{{ item.poster }}" class="item-thumb" alt="">
                    {% else %}
                        <span class="item-icon">{{ typeIcon[type] }}</span>
                    {% endif %}
                    <span class="item-name">{{ item.title ?? item.filename }}</span>
                    <span class="item-meta">
                        {% set parts = [] %}
                        {% if item.author %}{% set parts = parts|merge([item.author]) %}{% endif %}
                        {% if item.series and item.series != (item.title ?? item.filename) %}
                            {% set parts = parts|merge([item.series]) %}
                        {% endif %}
                        {% if item.year %}{% set parts = parts|merge([item.year ~ '']) %}{% endif %}
                        {# Show format only for types where it meaningfully differs (books, audiobooks) #}
                        {% if type in ['books', 'audiobooks'] %}
                            {% set parts = parts|merge([item.extension|upper]) %}
                        {% endif %}
                        {{ parts|join(' · ') }}
                    </span>
                </a>
                <button class="item-menu-btn" data-id="{{ item.id }}" data-type="{{ type }}" data-label="{{ (item.title ?? item.filename)|e }}" onclick="openItemMenu(event,this)" title="Options">···</button>
            </div>
        {% else %}
            <p style="color: var(--muted);">No {{ typeLabel[type]|lower }} found. Run a scan to index your library.</p>
        {% endfor %}
    </div>
{% endif %}

{% if pages > 1 %}
<div class="pagination">
    {% if page > 1 %}
        <a href="?page={{ page - 1 }}">&larr; Prev</a>
    {% endif %}
    {% for p in 1..pages %}
        {% if p == page %}
            <span class="current">{{ p }}</span>
        {% else %}
            <a href="?page={{ p }}">{{ p }}</a>
        {% endif %}
    {% endfor %}
    {% if page < pages %}
        <a href="?page={{ page + 1 }}">Next &rarr;</a>
    {% endif %}
</div>
{% endif %}
{% endblock %}
