APP_DEBUG=false
LIBRARY_PATH=/media

# ── Arr stack (optional) ─────────────────────────────────────────────────────
# Use the container name or LAN IP of each service.
# If they're in the same Docker network you can use service names directly.
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

RADARR_URL=http://radarr:7878
RADARR_API_KEY=

LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=

# ── Metadata APIs (optional) ─────────────────────────────────────────────────
TMDB_API_KEY=
MUSICBRAINZ_USER_AGENT=MediaServer/1.0

# ── Real-Debrid (optional) ───────────────────────────────────────────────────
REAL_DEBRID_API_KEY=
